#!/usr/bin/env python3
"""Run inexpensive local checks before the final workspace verification."""

import argparse
from pathlib import Path
import signal
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("--plan-id", required=True, help="Open Jig work plan to validate")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    launcher = root / "scripts/jig"
    command = [str(launcher), "work", "check", "--plan-id", args.plan_id]
    child = None
    interrupted = None

    def cancel(signum, _frame):
        nonlocal interrupted
        interrupted = signum
        if child is not None and child.poll() is None:
            try:
                child.send_signal(signum)
            except ProcessLookupError:
                pass

    previous = {sig: signal.signal(sig, cancel) for sig in (signal.SIGINT, signal.SIGTERM)}
    try:
        # Jig owns freshness, exact invocation reuse, and the complete final
        # requirements. Do not turn preflight checks into test dependencies.
        for phase in ("iteration", "final"):
            if interrupted is not None:
                return 128 + interrupted
            child = subprocess.Popen([*command, "--phase", phase], cwd=root)
            if interrupted is not None:
                cancel(interrupted, None)
            status = child.wait()
            if interrupted is not None:
                return 128 + interrupted
            if status:
                return status if status > 0 else 128 - status
        return 0
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except OSError as error:
        print(f"Cannot run local validation: {error}", file=sys.stderr)
        sys.exit(1)
