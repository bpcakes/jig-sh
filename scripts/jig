#!/bin/sh
set -eu
# jig-generated-runtime-launcher:v1
# jig-runtime-repository-scope:v1
# jig-check-subcommands:fmt,lint,clippy,test,test-locked,typescript-lint,typescript-typecheck,typescript-build,typescript-coverage,sqlx,sqlc,schema,contract,agent-map,agent-guides,rust-file-loc,no-mod-rs,migration-immutability,sqlx-unchecked-non-test
# jig-capability-only-subcommands:adopt,codex,doctor,init,presets,update
# jig-repository-scope-subcommands:agent,agent-map,bootstrap,check,dev,generate-sqlx-unchecked-queries-todo,info,loop,mcp,migration,migration-add,prompt,proxy,schema-dump,setup,sqlx,state,status,ui,vault,work
# jig-global-flags:--json

# Keep launcher behavior synchronized with templates/project/scripts/jig.jinja;
# the template may gate source-checkout-only user messages.
SCRIPT_DIR="$(dirname "$0")"
ROOT_DIR="$(CDPATH= cd "$SCRIPT_DIR/.." && pwd -P)"
INSTALLER="$ROOT_DIR/scripts/install-jig.sh"
CONTRACT_VERSION="4"

if [ ! -x "$INSTALLER" ]; then
  printf '%s\n' "Missing $INSTALLER." >&2
  exit 1
fi

run_installer() {
  if [ "$installer_scope" = repository ]; then
    "$INSTALLER" --contract-version "$CONTRACT_VERSION" --repository-scope "$@"
  else
    "$INSTALLER" --contract-version "$CONTRACT_VERSION" "$@"
  fi
}

jig_is_global_flag() {
  case "$1" in
    # jig-global-flags-begin
    --json)
      # jig-global-flags-end
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

jig_info_requested_before_separator() {
  [ "$#" -gt 0 ] || return 0
  command_seen=0
  for arg in "$@"; do
    if jig_is_global_flag "$arg"; then
      continue
    fi
    case "$arg" in
      --)
        return 1
        ;;
      -h | --help)
        return 0
        ;;
      -V | --version)
        if [ "$command_seen" -eq 0 ]; then
          return 0
        fi
        return 1
        ;;
      -*)
        return 1
        ;;
      *)
        command_seen=1
        ;;
    esac
  done
  return 1
}

jig_subcommand() {
  launcher_options=1
  for arg in "$@"; do
    if [ "$launcher_options" -eq 1 ] && [ "$arg" = "--" ]; then
      launcher_options=0
      continue
    fi
    if [ "$launcher_options" -eq 1 ] && jig_is_global_flag "$arg"; then
      continue
    fi
    case "$arg" in
      -*)
        return 1
        ;;
      *)
        printf '%s\n' "$arg"
        return 0
        ;;
    esac
  done
  return 1
}

jig_capability_only_requested() {
  capability_command=
  launcher_options=1
  for arg in "$@"; do
    if [ -z "$capability_command" ] \
      && [ "$launcher_options" -eq 1 ] \
      && [ "$arg" = "--" ]; then
      launcher_options=0
      continue
    fi
    if [ "$launcher_options" -eq 1 ] && jig_is_global_flag "$arg"; then
      continue
    fi
    if [ -z "$capability_command" ] && [ "$launcher_options" -eq 1 ]; then
      case "$arg" in
        -*)
          return 1
          ;;
      esac
    fi
    case "$capability_command" in
      '')
        capability_command="$arg"
        case "$capability_command" in
          # jig-capability-only-subcommands-begin
          adopt | codex | doctor | init | presets | update)
            # jig-capability-only-subcommands-end
            return 0
            ;;
          check)
            ;;
          # jig-repository-scope-subcommands-begin
          agent | agent-map | bootstrap | dev | generate-sqlx-unchecked-queries-todo | info | loop | mcp | migration | migration-add | prompt | proxy | schema-dump | setup | sqlx | state | status | ui | vault | work)
            # jig-repository-scope-subcommands-end
            return 1
            ;;
          *)
            # Unknown top-level commands only need a capable parser. Let
            # Clap report the typo even when this repository is broken.
            return 0
            ;;
        esac
        ;;
      check)
        case "$arg" in
          -h | --help | -V | --version)
            return 0
            ;;
          --plan-id)
            capability_command=check-plan-id
            ;;
          --plan-id=*)
            ;;
          --no-receipt)
            ;;
          contract)
            capability_command=check-contract
            ;;
          # jig-strict-check-subcommands-begin
          fmt | lint | clippy | test | test-locked | typescript-lint | typescript-typecheck | typescript-build | typescript-coverage | sqlx | sqlc | schema | agent-map | agent-guides | rust-file-loc | no-mod-rs | migration-immutability | sqlx-unchecked-non-test)
            # jig-strict-check-subcommands-end
            return 1
            ;;
          *)
            # Bare check, selectors, and unknown check-shaped input must be
            # pinned to this repository. Clap can still diagnose a typo after
            # the launcher validates the repository boundary.
            return 1
            ;;
        esac
        ;;
      check-plan-id)
        capability_command=check
        ;;
      check-contract)
        case "$arg" in
          -h | --help | -V | --version)
            return 0
            ;;
          --plan-id)
            capability_command=check-contract-plan-id
            ;;
          --plan-id=*)
            ;;
          --no-receipt)
            ;;
          *)
            return 1
            ;;
        esac
        ;;
      check-contract-plan-id)
        capability_command=check-contract
        ;;
    esac
  done
  # A global-only invocation behaves like bare help. Bare `check` is a valid
  # repository operation and therefore stays repository-scoped.
  [ -z "$capability_command" ] \
    || [ "$capability_command" = check-contract ] \
    || [ "$capability_command" = check-contract-plan-id ]
}

resolve_cached_binary() {
  requested_profile="$1"
  run_installer --profile "$requested_profile" --resolve-only
}

resolve_info_binary() {
  if [ -n "${JIG_DEV_BIN:-}" ]; then
    # The installer treats an explicit development binary as authoritative.
    run_installer --profile runtime
    return
  fi

  resolve_cached_binary runtime
}

resolve_or_install_info_binary() {
  if [ -n "${JIG_DEV_BIN:-}" ]; then
    # An explicit development binary is authoritative. Propagate its single
    # compatibility failure instead of retrying the identical installer path.
    bin_path="$(resolve_info_binary)"
    return
  fi
  if ! bin_path="$(resolve_info_binary)"; then
    printf '%s\n' \
      "Preparing a Jig runtime compatible with contract $CONTRACT_VERSION for help or version output; first run may install the repo-local runtime." >&2
    bin_path="$(run_installer --profile runtime)"
  fi
}

resolve_or_install_doctor_binary() {
  if [ -n "${JIG_DEV_BIN:-}" ]; then
    bin_path="$(run_installer --profile runtime)"
    return
  fi
  if bin_path="$(resolve_cached_binary runtime)"; then
    return
  fi
  printf '%s\n' \
    "No cached Jig runtime is available for doctor; preparing one compatible with launcher contract $CONTRACT_VERSION." >&2
  bin_path="$(run_installer --profile runtime)"
}

resolve_mcp_binary() {
  if [ -n "${JIG_DEV_BIN:-}" ]; then
    run_installer --profile mcp
    return
  fi

  if resolve_cached_binary mcp; then
    return
  fi

  printf '%s\n' \
    "No prebuilt Jig binary compatible with contract $CONTRACT_VERSION is available for MCP startup." \
    "Refusing to run cargo install during MCP initialization because it can block the client startup path." \
    "" \
    "Run a normal Jig command once to populate the cache:" \
    "  scripts/jig check contract" \
    "" >&2
  printf '%s\n' \
    "For the jig-sh source checkout, build and select the development binary explicitly:" \
    "  cargo build -p jig-sh --bin jig" \
    "  JIG_DEV_BIN=target/debug/jig scripts/jig mcp" >&2
  exit 1
}

# Keep repo-contract, work, and agent commands on stripped builds. MCP startup
# resolves a prebuilt binary without invoking the installer.
subcommand="$(jig_subcommand "$@" || true)"
installer_scope=repository
info_requested=0
if jig_info_requested_before_separator "$@"; then
  info_requested=1
fi
if [ "$info_requested" -eq 1 ] || jig_capability_only_requested "$@"; then
  installer_scope=capability
fi
selected_profile=runtime
case "$subcommand" in
  mcp)
    selected_profile=mcp
    bin_path="$(resolve_mcp_binary)" || exit $?
    ;;
  doctor)
    selected_profile=runtime
    resolve_or_install_doctor_binary
    ;;
  dev | proxy)
    if [ "$info_requested" -eq 1 ]; then
      selected_profile=runtime
      resolve_or_install_info_binary
    else
      selected_profile=default
      bin_path="$(run_installer --profile default)"
    fi
    ;;
  *)
    selected_profile=runtime
    if [ "$info_requested" -eq 1 ]; then
      resolve_or_install_info_binary
    else
      bin_path="$(run_installer --profile runtime)"
    fi
    ;;
esac

# Repo-local commands run with the binary's working directory set to the owning
# repository, even when this launcher is invoked by absolute path from another
# cwd. Commands that accept caller-relative paths must explicitly opt into
# JIG_INVOKE_CWD before the cd below.
case "$subcommand" in
  init | adopt | update)
    export JIG_INVOKE_CWD="$PWD"
    ;;
  *)
    unset JIG_INVOKE_CWD
    ;;
esac

if [ "$installer_scope" = repository ]; then
  # The installer has already proved binary capability. Hand strict repository
  # validation to that binary in-process so configuration errors remain
  # distinct from install failures without adding another startup subprocess.
  set -- \
    --__launcher-contract-version "$CONTRACT_VERSION" \
    --__launcher-profile "$selected_profile" \
    --__launcher-repo-root "$ROOT_DIR" \
    "$@"
fi

# Codex homes are user-global, and the launched Codex process must inherit the
# directory where the user invoked the launcher rather than this Jig repo.
if [ "$subcommand" = "codex" ]; then
  exec "$bin_path" "$@"
fi

cd "$ROOT_DIR"
exec "$bin_path" "$@"
