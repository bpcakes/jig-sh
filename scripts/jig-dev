#!/usr/bin/env python3
"""Build the current workspace Jig incrementally, then use the regular launcher."""

import json
import os
from pathlib import Path
import subprocess
import sys


def main():
    root = Path(__file__).resolve().parent.parent
    print("Building the current Jig development runtime...", file=sys.stderr)
    build = subprocess.run(
        [
            "cargo",
            "build",
            "--locked",
            "-p",
            "jig-sh",
            "--bin",
            "jig",
            "--message-format=json-render-diagnostics",
        ],
        cwd=root,
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )
    if build.returncode:
        return build.returncode if build.returncode > 0 else 128 - build.returncode

    executable = None
    for line in build.stdout.splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            print(line, file=sys.stderr)
            continue
        if (
            message.get("reason") == "compiler-artifact"
            and message.get("target", {}).get("name") == "jig"
            and "bin" in message.get("target", {}).get("kind", [])
            and message.get("executable")
        ):
            executable = root / message["executable"]

    if executable is None or not executable.is_file() or not os.access(executable, os.X_OK):
        print("Jig development build did not produce an executable.", file=sys.stderr)
        return 1

    # Cargo reports the actual artifact, including CARGO_TARGET_DIR and configured
    # build targets. Leave our cwd intact so init/update arguments stay relative to
    # the caller, while the normal launcher still supplies its repository root.
    env = dict(os.environ, JIG_DEV_BIN=str(executable.resolve()))
    launcher = str(root / "scripts" / "jig")
    os.execve(launcher, [launcher, *sys.argv[1:]], env)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except OSError as error:
        print(f"Cannot run the Jig development runtime: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
