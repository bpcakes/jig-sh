name: Go Tests

on:
  pull_request:
    paths:
      - "**/*.go"
      - "go.mod"
      - "go.sum"
      - "go.work"
      - "go.work.sum"
      - "**/go.mod"
      - "**/go.sum"
      - "**/go.work"
      - "**/go.work.sum"
      - "vendor/modules.txt"
      - "**/vendor/modules.txt"
      - "openapi/**"
[% if go_postgres_enabled %]
      - "sqlc.yaml"
      - "**/*.sql"
      - "internal/database/queries/**"
      - <<[ (migration_dir ~ "/**") | tojson ]>>
      - "scripts/test-postgres.sh"
[% endif %]
      - ".jig.toml"
      - ".agent/jig-contract.json"
      - ".github/workflows/go-tests.yml"
  push:
    branches:
      - <<[ default_branch | tojson ]>>
    paths:
      - "**/*.go"
      - "go.mod"
      - "go.sum"
      - "go.work"
      - "go.work.sum"
      - "**/go.mod"
      - "**/go.sum"
      - "**/go.work"
      - "**/go.work.sum"
      - "vendor/modules.txt"
      - "**/vendor/modules.txt"
      - "openapi/**"
[% if go_postgres_enabled %]
      - "sqlc.yaml"
      - "**/*.sql"
      - "internal/database/queries/**"
      - <<[ (migration_dir ~ "/**") | tojson ]>>
      - "scripts/test-postgres.sh"
[% endif %]
      - ".jig.toml"
      - ".agent/jig-contract.json"
      - ".github/workflows/go-tests.yml"
  merge_group:
    types:
      - checks_requested
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: go-ci-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  checks:
    runs-on: <<[ ci_github_runner | tojson ]>>
    steps:
      - uses: actions/checkout@v6
      - uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          cache: false
          rustflags: ""
      - uses: actions/setup-go@v6
        with:
          go-version-file: <<[ go_toolchain_authority_path | tojson ]>>
          cache: true
          cache-dependency-path: |
            go.sum
            go.mod
      - run: scripts/jig check fmt
      - run: scripts/jig check lint
      - run: scripts/jig check test-locked
[% if go_postgres_enabled %]      - run: scripts/jig check sqlc
[% endif %]
[% if go_postgres_enabled %]
  postgres-integration:
    # GitHub-hosted macOS runners do not provide the Docker daemon required by
    # scripts/test-postgres.sh.
    runs-on: "ubuntu-latest"
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-go@v6
        with:
          go-version-file: <<[ go_toolchain_authority_path | tojson ]>>
          cache: true
          cache-dependency-path: |
            go.sum
            go.mod
      - run: bash scripts/test-postgres.sh
[% endif %]
