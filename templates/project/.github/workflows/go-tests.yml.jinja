name: Go Tests

on:
  pull_request:
    paths:
      - "**/*.go"
      - "go.mod"
      - "go.sum"
      - "openapi/**"
[% if go_database == "postgres" %]
      - "sqlc.yaml"
      - "internal/database/queries/**"
      - <<[ (migration_dir ~ "/**") | tojson ]>>
[% endif %]
      - ".jig.toml"
      - ".agent/jig-contract.json"
      - ".github/workflows/go-tests.yml"
  push:
    branches:
      - <<[ default_branch | tojson ]>>
    paths:
      - "**/*.go"
      - "go.mod"
      - "go.sum"
      - "openapi/**"
[% if go_database == "postgres" %]
      - "sqlc.yaml"
      - "internal/database/queries/**"
      - <<[ (migration_dir ~ "/**") | tojson ]>>
[% endif %]
      - ".jig.toml"
      - ".agent/jig-contract.json"
      - ".github/workflows/go-tests.yml"
  merge_group:
    types:
      - checks_requested
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: go-ci-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  checks:
    runs-on: <<[ ci_github_runner | tojson ]>>
    steps:
      - uses: actions/checkout@v6
      - uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          cache: false
          rustflags: ""
      - uses: actions/setup-go@v6
        with:
          go-version-file: <<[ go_toolchain_authority_path ]>>
          cache: true
          cache-dependency-path: go.mod
      - run: scripts/jig check fmt
      - run: scripts/jig check lint
      - run: scripts/jig check test-locked
[% if go_database == "postgres" %]      - run: scripts/jig check sqlc
[% endif %]
[% if go_database == "postgres" %]
  postgres-integration:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-go@v6
        with:
          go-version-file: <<[ go_toolchain_authority_path ]>>
          cache: true
          cache-dependency-path: go.mod
      - run: bash scripts/test-postgres.sh
[% endif %]
