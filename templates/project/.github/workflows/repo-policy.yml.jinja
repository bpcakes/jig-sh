name: Repo Policy

on:
  pull_request:
  push:
    branches:
      - <<[ default_branch | tojson ]>>
  merge_group:
    types:
      - checks_requested
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: repo-policy-ci-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
[% if go_ci_workflow_enabled %]
  go-policy:
    name: Validate Go policy and contract
    runs-on: <<[ ci_github_runner | tojson ]>>
    defaults:
      run:
        shell: bash
    steps:
      - name: Checkout
        uses: actions/checkout@v6
      - name: Install Rust toolchain for Jig
        uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          cache: false
          rustflags: ""
      - name: Resolve Go toolchain version
        id: go-version
        run: |
          version="$(scripts/jig info go-version)"
          printf 'version=%s\n' "$version" >> "$GITHUB_OUTPUT"
      - name: Install Go toolchain
        uses: actions/setup-go@v6
        with:
          go-version: ${{ steps.go-version.outputs.version }}
          cache: true
          cache-dependency-path: |
            go.mod
            go.sum
            go.work
            go.work.sum
            **/go.mod
            **/go.sum
            **/go.work
            **/go.work.sum
            vendor/modules.txt
            **/vendor/modules.txt
      - name: Validate contract
        run: scripts/jig check contract
      - name: Check formatting
        run: scripts/jig check <<[ go_fmt_ci_target ]>>
      - name: Run Go vet
        run: scripts/jig check <<[ go_lint_ci_target ]>>
[% if go_sqlc_ci_enabled %]
      - name: Check sqlc drift
        run: scripts/jig check <<[ go_sqlc_ci_target ]>>
[% endif %]
[% endif %]
[% if rust_backend_enabled %]
  no-mod-rs:
    name: Check for disallowed mod.rs files
    runs-on: <<[ ci_github_runner | tojson ]>>
    defaults:
      run:
        shell: bash
    steps:
      - name: Checkout
        uses: actions/checkout@v6
      - name: Install Rust toolchain
        uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          cache: false
          rustflags: ""
      - name: Detect disallowed mod.rs files
        run: |
          scripts/jig check no-mod-rs
[% endif %]

[% if file_budget_ci_enabled %]
  file-budget:
    name: Enforce repository file budgets
    runs-on: <<[ ci_github_runner | tojson ]>>
    defaults:
      run:
        shell: bash
    steps:
      - name: Checkout
        uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - name: Install Rust toolchain
        uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          cache: false
          rustflags: ""
      - name: Check repository file-budget policy
        env:
          JIG_EVENT_NAME: ${{ github.event_name }}
          JIG_PULL_REQUEST_BASE: ${{ github.event.pull_request.base.sha }}
          JIG_PUSH_BEFORE: ${{ github.event.before }}
          JIG_MERGE_GROUP_BASE: ${{ github.event.merge_group.base_sha }}
        run: |
          set -euo pipefail

          case "$JIG_EVENT_NAME" in
            pull_request)
              scripts/jig check repo:file-budget \
                --comparison-exact-tree "$JIG_PULL_REQUEST_BASE" \
                --comparison-provenance explicit
              ;;
            push)
              scripts/jig check repo:file-budget \
                --comparison-exact-tree "$JIG_PUSH_BEFORE" \
                --comparison-provenance push_before
              ;;
            merge_group)
              scripts/jig check repo:file-budget \
                --comparison-exact-tree "$JIG_MERGE_GROUP_BASE" \
                --comparison-provenance explicit
              ;;
            *)
              scripts/jig check repo:file-budget
              ;;
          esac
[% endif %]

[% if rust_backend_enabled %]
[% if sqlx_enabled %]
  sqlx-unchecked-queries:
    name: Verify non-test SQLx queries are compile-time checked
    runs-on: <<[ ci_github_runner | tojson ]>>
    defaults:
      run:
        shell: bash
    steps:
      - name: Checkout
        uses: actions/checkout@v6
      - name: Install Rust toolchain
        uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          cache: false
          rustflags: ""
      - name: Check unchecked SQLx query usage in non-test code
        run: |
          scripts/jig check sqlx-unchecked-non-test

[% endif %]
[% endif %]
[% if sqlx_enabled or go_postgres_enabled %]
  migration-immutability:
    name: Enforce migration immutability
    runs-on: <<[ ci_github_runner | tojson ]>>
    defaults:
      run:
        shell: bash
    steps:
      - name: Checkout
        uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - name: Install Rust toolchain
        uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          cache: false
          rustflags: ""
      - name: Determine base ref
        id: base_ref
        shell: bash
        env:
          JIG_DEFAULT_BRANCH: <<[ default_branch | tojson ]>>
        run: |
          set -euo pipefail

          ref=""
          event_name="${{ github.event_name }}"

          if [[ "$event_name" == "pull_request" ]]; then
            ref="${{ github.event.pull_request.base.sha }}"
          elif [[ "$event_name" == "push" ]]; then
            ref="${{ github.event.before }}"
            if [[ "$ref" == "0000000000000000000000000000000000000000" ]]; then
              ref=""
            fi
          elif [[ "$event_name" == "merge_group" ]]; then
            ref="${{ github.event.merge_group.base_sha }}"
          fi

          if [[ -z "$ref" ]]; then
            if git rev-parse --verify "origin/$JIG_DEFAULT_BRANCH" >/dev/null 2>&1; then
              ref="$(git merge-base HEAD "origin/$JIG_DEFAULT_BRANCH")"
            elif git rev-parse --verify HEAD^ >/dev/null 2>&1; then
              ref="HEAD^"
            else
              ref="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
            fi
          fi

          echo "ref=$ref" >>"$GITHUB_OUTPUT"
      - name: Check migration immutability
        run: |
          scripts/jig check migration-immutability --changed-against "${{ steps.base_ref.outputs.ref }}"
[% endif %]
