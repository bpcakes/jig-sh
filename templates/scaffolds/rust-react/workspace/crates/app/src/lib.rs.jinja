use std::net::{IpAddr, SocketAddr};

use ::<<[ module_name ]>>_core::AppVersion;
[% if db_enabled %]
#[cfg(feature = "db")]
pub use ::<<[ module_name ]>>_db as db;
[% endif %]
use anyhow::{Context, Result};

#[derive(Clone, Debug)]
pub struct AppConfig {
    version: AppVersion,
    bind_addr: SocketAddr,
[% if db_enabled %]
    #[cfg(feature = "db")]
    database_url: Option<String>,
[% endif %]
}

impl AppConfig {
    pub fn from_env() -> Result<Self> {
        Self::from_env_with_version(env!("CARGO_PKG_VERSION"))
    }

    pub fn from_env_with_version(version: impl Into<String>) -> Result<Self> {
        let host = std::env::var("HOST").ok();
        let port = std::env::var("PORT").ok();
        let configured_bind_addr = std::env::var("BIND_ADDR").ok();
        let bind_addr = resolve_bind_addr(
            host.as_deref(),
            port.as_deref(),
            configured_bind_addr.as_deref(),
        )?;
[% if db_enabled %]

        #[cfg(feature = "db")]
        let database_url = Some(
            std::env::var("DATABASE_URL")
                .context("DATABASE_URL is required when the db feature is enabled")?,
        );
[% endif %]

        Ok(Self {
            version: AppVersion::new(version),
            bind_addr,
            [% if db_enabled %]
            #[cfg(feature = "db")]
            database_url,
            [% endif %]
        })
    }

    pub fn for_tests() -> Self {
        Self::for_tests_with_version(env!("CARGO_PKG_VERSION"))
    }

    pub fn for_tests_with_version(version: impl Into<String>) -> Self {
        Self {
            version: AppVersion::new(version),
            bind_addr: "127.0.0.1:0".parse().expect("test bind address is valid"),
            [% if db_enabled %]
            #[cfg(feature = "db")]
            database_url: None,
            [% endif %]
        }
    }

    pub fn bind_addr(&self) -> SocketAddr {
        self.bind_addr
    }

    pub fn version(&self) -> &AppVersion {
        &self.version
    }
[% if db_enabled %]

    #[cfg(feature = "db")]
    pub fn database_url(&self) -> Option<&str> {
        self.database_url.as_deref()
    }
[% endif %]
}

fn resolve_bind_addr(
    host: Option<&str>,
    port: Option<&str>,
    configured_bind_addr: Option<&str>,
) -> Result<SocketAddr> {
    if let (Some(host), Some(port)) = (
        host.filter(|value| !value.is_empty()),
        port.filter(|value| !value.is_empty()),
    ) {
        let host = host
            .parse::<IpAddr>()
            .with_context(|| format!("Failed to parse HOST '{host}' as an IP address"))?;
        let port = port
            .parse::<u16>()
            .with_context(|| format!("Failed to parse PORT '{port}' as a TCP port"))?;
        return Ok(SocketAddr::new(host, port));
    }

    let bind_addr = configured_bind_addr.unwrap_or("127.0.0.1:0");
    bind_addr
        .parse()
        .with_context(|| format!("Failed to parse BIND_ADDR '{bind_addr}' as a socket address"))
}

#[derive(Clone, Debug)]
pub struct AppState {
    config: AppConfig,
    [% if db_enabled %]
    #[cfg(feature = "db")]
    db: Option<db::Db>,
    [% endif %]
}

impl AppState {
    pub fn new() -> Self {
        Self::for_tests()
    }

    pub fn new_with_version(version: impl Into<String>) -> Self {
        Self::for_tests_with_version(version)
    }

    pub fn for_tests() -> Self {
        Self::for_tests_with_version(env!("CARGO_PKG_VERSION"))
    }

    pub fn for_tests_with_version(version: impl Into<String>) -> Self {
        Self::from_test_config(AppConfig::for_tests_with_version(version))
    }

    pub fn from_test_config(config: AppConfig) -> Self {
        [% if db_enabled %]
        Self {
            config,
            #[cfg(feature = "db")]
            db: None,
        }
        [% else %]
        Self { config }
        [% endif %]
    }

    pub async fn from_config(config: AppConfig) -> Result<Self> {
        [% if db_enabled %]
        #[cfg(feature = "db")]
        {
            let database_url = config.database_url().ok_or_else(|| {
                anyhow::anyhow!("DATABASE_URL is required to initialize the database")
            })?;
            let db = db::Db::connect(database_url)
                .await
                .context("Failed to connect to the database")?;
            db.migrate()
                .await
                .context("Failed to run database migrations")?;
            Ok(Self {
                config,
                db: Some(db),
            })
        }

        #[cfg(not(feature = "db"))]
        {
            Ok(Self {
                config,
                #[cfg(feature = "db")]
                db: None,
            })
        }
        [% else %]
        Ok(Self { config })
        [% endif %]
    }
[% if db_enabled %]

    #[cfg(feature = "db")]
    pub async fn bootstrap_database(config: &AppConfig) -> Result<bool> {
        let database_url = config
            .database_url()
            .ok_or_else(|| anyhow::anyhow!("DATABASE_URL is required to bootstrap the database"))?;
        let created = db::Db::create_if_missing(database_url)
            .await
            .context("Failed to create the database")?;
        let db = db::Db::connect(database_url)
            .await
            .context("Failed to connect to the database")?;
        db.migrate()
            .await
            .context("Failed to run database migrations")?;
        Ok(created)
    }
[% endif %]

    pub fn config(&self) -> &AppConfig {
        &self.config
    }

    pub fn version(&self) -> &AppVersion {
        self.config.version()
    }

    pub fn is_ready(&self) -> bool {
        [% if db_enabled %]
        #[cfg(feature = "db")]
        {
            self.db.is_some()
        }

        #[cfg(not(feature = "db"))]
        {
            true
        }
        [% else %]
        true
        [% endif %]
    }
[% if db_enabled %]

    #[cfg(feature = "db")]
    pub fn db(&self) -> Option<&db::Db> {
        self.db.as_ref()
    }
[% endif %]
}

impl Default for AppState {
    fn default() -> Self {
        Self::new()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use ::<<[ module_name ]>>_core::APP_NAME;

    #[test]
    fn app_state_uses_current_version() {
        assert_eq!(AppState::new().version().name, APP_NAME);
    }

    #[test]
    fn test_config_uses_loopback_bind_addr() {
        assert_eq!(
            AppConfig::for_tests().bind_addr().to_string(),
            "127.0.0.1:0"
        );
    }

    #[test]
    fn injected_host_and_port_override_the_dotenv_bind_address() {
        assert_eq!(
            resolve_bind_addr(Some("127.0.0.1"), Some("4317"), Some("127.0.0.1:3000")).unwrap(),
            "127.0.0.1:4317".parse().unwrap()
        );
        assert_eq!(
            resolve_bind_addr(Some("::1"), Some("4318"), Some("127.0.0.1:3000")).unwrap(),
            "[::1]:4318".parse().unwrap()
        );
    }

    #[test]
    fn partial_jig_bind_values_fall_back_to_bind_addr() {
        assert_eq!(
            resolve_bind_addr(Some("127.0.0.1"), None, Some("127.0.0.1:3000")).unwrap(),
            "127.0.0.1:3000".parse().unwrap()
        );
    }
}
