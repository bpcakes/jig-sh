mod public;

use ::<<[ module_name ]>>::AppState;
use ::<<[ module_name ]>>_http_common::not_found;
use axum::Router;
use batter::lifecycle::{LifecycleStatus, OperationAdmission, ShutdownHandle};
use utoipa::openapi::OpenApi;

pub fn router(state: AppState) -> Router {
    let (shutdown, approval) = ShutdownHandle::new_with_readiness_approval();
    let lifecycle = shutdown.status();
    let admission = shutdown.operation_admission();
    approval.approve();
    router_with_lifecycle(state, lifecycle, admission)
}

pub fn router_with_lifecycle(
    state: AppState,
    lifecycle: LifecycleStatus,
    admission: OperationAdmission,
) -> Router {
    let router = public::operational_routes(lifecycle, admission).fallback(not_found);

    router
        .with_state(state)
        .layer(axum::middleware::from_fn(batter_axum::operational_http))
}

pub fn public_openapi() -> OpenApi {
    public::routes().into_openapi()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn committed_public_openapi_is_current() {
        assert_document_matches(
            public_openapi(),
            include_str!(concat!(
                env!("CARGO_MANIFEST_DIR"),
                "/../../openapi/public.json"
            )),
            "public",
        );
    }

    fn assert_document_matches(document: OpenApi, expected: &str, name: &str) {
        let actual = format!(
            "{}\n",
            serde_json::to_string_pretty(&document).expect("OpenAPI document serializes")
        );
        assert_eq!(
            actual, expected,
            "{name} OpenAPI document is stale; run the contract:generate package script"
        );
    }
}
