use std::str::FromStr;
use std::time::Duration;

use anyhow::Context;
use batter::{cleanup::CleanupSlot, operation::OperationContext};
use sqlx::{
    migrate::MigrateDatabase,
    postgres::{PgConnectOptions, PgPoolOptions},
};

pub type DbPool = sqlx::<<[ db_pool ]>>;

pub const DEFAULT_DB_TIMEOUT: Duration = Duration::from_secs(30);

#[derive(Clone, Debug)]
pub struct Db {
    pool: DbPool,
}

impl Db {
    pub async fn create_if_missing(database_url: &str) -> anyhow::Result<bool> {
        if Self::database_exists(database_url).await? {
            return Ok(false);
        }

        let create_result = tokio::time::timeout(
            DEFAULT_DB_TIMEOUT,
            sqlx::<<[ db_database ]>>::create_database(database_url),
        )
        .await
        .with_context(|| format!("Timed out creating the database after {DEFAULT_DB_TIMEOUT:?}"))
        .and_then(|result| result.map_err(Into::into));
        match create_result {
            Ok(()) => Ok(true),
            Err(create_error) => match Self::database_exists(database_url).await {
                Ok(true) => Ok(false),
                Ok(false) => Err(create_error),
                Err(recheck_error) => Err(create_error.context(format!(
                    "Could not confirm database existence after creation failed: {recheck_error:#}"
                ))),
            },
        }
    }

    async fn database_exists(database_url: &str) -> anyhow::Result<bool> {
        tokio::time::timeout(
            DEFAULT_DB_TIMEOUT,
            sqlx::<<[ db_database ]>>::database_exists(database_url),
        )
        .await
        .with_context(|| {
            format!("Timed out checking whether the database exists after {DEFAULT_DB_TIMEOUT:?}")
        })?
        .map_err(Into::into)
    }

    /// Connect without registering lifecycle cleanup.
    ///
    /// This is intended for short-lived test helpers that own and close the
    /// returned pool directly. Service startup and commands must use
    /// [`Self::connect_in`].
    pub async fn connect(database_url: &str) -> anyhow::Result<Self> {
        Self::connect_with_timeout(database_url, DEFAULT_DB_TIMEOUT).await
    }

    pub async fn connect_with_timeout(
        database_url: &str,
        timeout_after: Duration,
    ) -> anyhow::Result<Self> {
        let pool = tokio::time::timeout(timeout_after, DbPool::connect(database_url))
            .await
            .with_context(|| {
                format!("Timed out connecting to database after {timeout_after:?}")
            })??;
        Ok(Self { pool })
    }

    /// Construct a lazy PostgreSQL pool, publish its close finalizer, then
    /// verify connectivity under a bounded child of the owning operation.
    pub async fn connect_in(
        database_url: &str,
        context: &OperationContext,
        cleanup: CleanupSlot<'_>,
    ) -> anyhow::Result<Self> {
        let options = PgConnectOptions::from_str(database_url)
            .context("Could not parse PostgreSQL database URL")?;
        let probe_context = context.child(DEFAULT_DB_TIMEOUT)?;
        let pool = batter::sqlx::pool_in(cleanup, PgPoolOptions::new(), options);
        batter::sqlx::probe(&pool, &probe_context)
            .await
            .context("Could not verify PostgreSQL connectivity")?;
        Ok(Self { pool })
    }

    pub fn pool(&self) -> &DbPool {
        &self.pool
    }

    pub async fn migrate(&self) -> anyhow::Result<()> {
        self.migrate_with_timeout(DEFAULT_DB_TIMEOUT).await
    }

    pub async fn migrate_with_timeout(&self, timeout_after: Duration) -> anyhow::Result<()> {
        tokio::time::timeout(timeout_after, self.run_migrations())
            .await
            .with_context(|| {
                format!("Timed out running database migrations after {timeout_after:?}")
            })??;
        Ok(())
    }

    async fn run_migrations(&self) -> anyhow::Result<()> {
        sqlx::migrate!(
            // Renderer-controlled values vary in length, so keep this rustfmt-stable shape.
            "<<[ migration_path ]>>"
        )
        .run(&self.pool)
        .await?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::Db;
    use batter::{
        cleanup::{CleanupBudget, CleanupOutcome, CleanupStack},
        operation::OperationContext,
    };
    use std::{
        io::{Read, Write},
        net::{TcpListener, TcpStream},
        time::Duration,
    };

    fn write_backend_message(stream: &mut TcpStream, tag: u8, body: &[u8]) {
        stream.write_all(&[tag]).expect("write message tag");
        let length = u32::try_from(body.len() + 4).expect("test message length fits in u32");
        stream
            .write_all(&length.to_be_bytes())
            .expect("write message length");
        stream.write_all(body).expect("write message body");
    }

    fn run_stalled_postgres(
        listener: TcpListener,
        query_started: tokio::sync::oneshot::Sender<()>,
    ) {
        let (mut stream, _) = listener.accept().expect("accept PostgreSQL connection");
        let mut length = [0_u8; 4];
        stream
            .read_exact(&mut length)
            .expect("read startup message length");
        let startup_length = u32::from_be_bytes(length) as usize;
        assert!(
            startup_length >= 8,
            "startup packet includes protocol version"
        );
        let mut startup = vec![0_u8; startup_length - 4];
        stream
            .read_exact(&mut startup)
            .expect("read startup message body");

        write_backend_message(&mut stream, b'R', &0_u32.to_be_bytes());
        write_backend_message(&mut stream, b'S', b"server_version\0\x31\x38.0\0");
        write_backend_message(&mut stream, b'S', b"client_encoding\0UTF8\0");
        write_backend_message(&mut stream, b'K', &[0_u8; 8]);
        write_backend_message(&mut stream, b'Z', b"I");
        stream.flush().expect("flush PostgreSQL startup response");

        let mut query_header = [0_u8; 5];
        stream
            .read_exact(&mut query_header)
            .expect("read first query protocol message");
        assert!(
            matches!(query_header[0], b'P' | b'Q'),
            "probe starts a PostgreSQL query"
        );
        query_started.send(()).expect("notify query start");

        let mut remainder = [0_u8; 1024];
        while stream
            .read(&mut remainder)
            .expect("read until client closes")
            != 0
        {}
    }

    #[tokio::test]
    async fn interrupted_established_probe_retires_lease_and_closes_pool() {
        let listener = TcpListener::bind("127.0.0.1:0").expect("bind local PostgreSQL stub");
        let port = listener.local_addr().expect("read listener address").port();
        let (query_started, query_waiting) = tokio::sync::oneshot::channel();
        let server = tokio::task::spawn_blocking(move || {
            run_stalled_postgres(listener, query_started);
        });

        let mut cleanup = CleanupStack::new();
        let context = OperationContext::new(Duration::from_secs(5)).unwrap();
        let cancelling = context.clone();
        let database_url = format!("postgres://postgres@127.0.0.1:{port}/example?sslmode=disable");
        let error = {
            let connecting = Db::connect_in(
                &database_url,
                &context,
                cleanup.reserve("database.close").unwrap(),
            );
            tokio::pin!(connecting);

            tokio::select! {
                biased;
                result = &mut connecting => panic!("probe completed before cancellation: {result:?}"),
                started = query_waiting => {
                    started.expect("the PostgreSQL stub observes the probe query");
                    cancelling.cancel();
                }
            }
            connecting
                .await
                .expect_err("cancellation interrupts the established query")
        };
        assert!(format!("{error:#}").contains("operation cancelled"));

        let report = tokio::time::timeout(
            Duration::from_secs(1),
            cleanup.close(
                CleanupBudget::new(
                    Duration::from_secs(1),
                    Duration::from_secs(1),
                    Duration::from_secs(1),
                )
                .unwrap(),
            ),
        )
        .await
        .expect("pool cleanup reaches an explicit outcome within the bound");
        assert!(report.is_success());
        assert_eq!(report.records.len(), 1);
        assert_eq!(report.records[0].name, "database.close");
        assert_eq!(report.records[0].outcome, CleanupOutcome::Succeeded);
        tokio::time::timeout(Duration::from_secs(1), server)
            .await
            .expect("the retired connection closes the stalled server session locally")
            .expect("the PostgreSQL stub exits cleanly");
    }
}
