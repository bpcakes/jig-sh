import { QueryClient } from "@tanstack/react-query"
import { RouterProvider, createMemoryHistory } from "@tanstack/react-router"
import { fireEvent, render, screen, waitFor } from "@testing-library/react"
import { afterEach, expect, it, vi } from "vitest"

import { AppProviders } from "@/app/providers"
import { createAppRouter } from "@/app/router"

// Renderer values are not length-bounded.
// prettier-ignore
const expectedAppName = "<<[ repo_name ]>>"

afterEach(() => vi.unstubAllGlobals())

function renderAdmin(initialEntry = "/") {
  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
      },
    },
  })
  const router = createAppRouter({
    history: createMemoryHistory({ initialEntries: [initialEntry] }),
    queryClient,
  })
  render(
    <AppProviders client={queryClient}>
      <RouterProvider router={router} />
    </AppProviders>
  )

  return router
}

it("shows application identity and readiness from the API", async () => {
  vi.stubGlobal(
    "fetch",
    vi.fn().mockResolvedValueOnce(
      new Response(
        JSON.stringify({
          version: { name: expectedAppName, version: "0.1.0" },
          ready: true,
        }),
        {
          status: 200,
          headers: { "Content-Type": "application/json" },
        }
      )
    )
  )

  renderAdmin()

  expect(
    await screen.findByRole("heading", { name: "Application status" })
  ).toBeDefined()
  expect(await screen.findByText("0.1.0")).toBeDefined()
  expect((await screen.findAllByText(expectedAppName)).length).toBeGreaterThan(
    0
  )
  expect(screen.getByText("Ready")).toBeDefined()
})

it("reports malformed API data and retries", async () => {
  const fetchMock = vi
    .fn()
    .mockResolvedValueOnce(
      new Response(JSON.stringify({ ready: true }), {
        status: 200,
        headers: { "Content-Type": "application/json" },
      })
    )
    .mockResolvedValueOnce(
      new Response(
        JSON.stringify({
          version: { name: expectedAppName, version: "0.2.0" },
          ready: true,
        }),
        {
          status: 200,
          headers: { "Content-Type": "application/json" },
        }
      )
    )
  vi.stubGlobal("fetch", fetchMock)

  renderAdmin()

  expect(await screen.findByText(/invalid input/i)).toBeDefined()
  fireEvent.click(screen.getByRole("button", { name: "Retry" }))
  expect(await screen.findByText("0.2.0")).toBeDefined()
  await waitFor(() => expect(fetchMock).toHaveBeenCalledTimes(2))
})

it("reports an unsuccessful API status response", async () => {
  vi.stubGlobal(
    "fetch",
    vi.fn().mockResolvedValueOnce(
      new Response(
        JSON.stringify({
          code: "dependency_unavailable",
          message: "A required dependency is unavailable",
          request_id: "request-admin-503",
        }),
        { status: 503, headers: { "Content-Type": "application/json" } }
      )
    )
  )

  renderAdmin()

  expect(
    await screen.findByText(
      /A required dependency is unavailable \(request request-admin-503\)/i
    )
  ).toBeDefined()
})

it("preserves a plain-text upstream error", async () => {
  vi.stubGlobal(
    "fetch",
    vi
      .fn()
      .mockResolvedValueOnce(new Response("Gateway timeout", { status: 504 }))
  )

  renderAdmin()

  expect(await screen.findByText("Gateway timeout")).toBeDefined()
})

it("uses a safe fallback for an unrecognized error body", async () => {
  vi.stubGlobal(
    "fetch",
    vi.fn().mockResolvedValueOnce(
      new Response(JSON.stringify({ internal: "must not be displayed" }), {
        status: 500,
        headers: { "Content-Type": "application/json" },
      })
    )
  )

  renderAdmin()

  expect(await screen.findByText("API request failed")).toBeDefined()
  expect(screen.queryByText(/must not be displayed/i)).toBeNull()
})

it("shows a connected application that is not ready", async () => {
  vi.stubGlobal(
    "fetch",
    vi.fn().mockResolvedValueOnce(
      new Response(
        JSON.stringify({
          version: { name: expectedAppName, version: "0.3.0" },
          ready: false,
        }),
        {
          status: 200,
          headers: { "Content-Type": "application/json" },
        }
      )
    )
  )

  renderAdmin()

  expect(await screen.findByText("Not ready")).toBeDefined()
  expect(screen.getByText("Unavailable")).toBeDefined()
})

it("navigates between generated admin routes", async () => {
  vi.stubGlobal(
    "fetch",
    vi.fn().mockResolvedValueOnce(
      new Response(
        JSON.stringify({
          version: { name: expectedAppName, version: "0.1.0" },
          ready: true,
        }),
        {
          status: 200,
          headers: { "Content-Type": "application/json" },
        }
      )
    )
  )

  renderAdmin()

  expect(
    await screen.findByRole("heading", { name: "Application status" })
  ).toBeDefined()
  fireEvent.click(screen.getByRole("link", { name: "Settings" }))
  expect(
    await screen.findByRole("heading", {
      name: "Project-owned configuration",
    })
  ).toBeDefined()
  fireEvent.click(screen.getByRole("link", { name: "Overview" }))
  expect(
    await screen.findByRole("heading", { name: "Application status" })
  ).toBeDefined()
})

it("renders the admin not-found route", async () => {
  renderAdmin("/missing")

  expect(
    await screen.findByRole("heading", { name: "Page not found" })
  ).toBeDefined()
  expect(screen.getByRole("link", { name: "Return to overview" })).toBeDefined()
})
