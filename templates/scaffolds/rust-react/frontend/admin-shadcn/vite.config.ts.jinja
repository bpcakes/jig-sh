/// <reference types="vitest/config" />
import path from "node:path"

import tailwindcss from "@tailwindcss/vite"
import react from "@vitejs/plugin-react"
import { defineConfig } from "vite"

const devPort = Number(process.env.PORT)
const server =
  Number.isInteger(devPort) && devPort > 0
    ? {
        host: "127.0.0.1",
        port: devPort,
        strictPort: true,
        hmr: {
          host: "127.0.0.1",
          clientPort: devPort,
        },
      }
    : {}
const apiOrigin =
  // A current Jig session owns its namespaced topology. API_ORIGIN remains the
  // direct-Vite override when no managed API was selected.
  firstNonEmpty(process.env.JIG_DEV_API_ORIGIN, process.env.API_ORIGIN) ??
  "http://api.<<[ repo_dns_label ]>>.localhost:1355"

export default defineConfig({
  plugins: [react(), tailwindcss()],
  resolve: {
    alias: {
      "@": path.resolve(__dirname, "./src"),
    },
  },
  server: {
    ...server,
    proxy: {
      "/api": { target: apiOrigin, changeOrigin: true },
      "/health": { target: apiOrigin, changeOrigin: true },
    },
  },
  test: {
    environment: "jsdom",
    globals: true,
    setupFiles: ["./src/test-setup.ts"],
    coverage: {
      include: ["src/features/**/*.{ts,tsx}", "src/lib/api.ts"],
    },
  },
})

function firstNonEmpty(
  ...values: Array<string | undefined>
): string | undefined {
  return values.map((value) => value?.trim()).find((value) => Boolean(value))
}
