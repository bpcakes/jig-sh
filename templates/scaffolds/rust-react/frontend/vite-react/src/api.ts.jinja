import {
  client as publicApiClient,
  getAppStatusOptions,
  type AppStatusResponse,
  zApiErrorResponse,
} from "<<[ public_api_client_package ]>>";

publicApiClient.interceptors.error.use(normalizeApiError);

export type AppStatus = AppStatusResponse;
export const appStatusQueryOptions = getAppStatusOptions({
  baseUrl: globalThis.location.origin,
});

function normalizeApiError(error: unknown): Error {
  if (error instanceof Error) return error;
  const parsed = zApiErrorResponse.safeParse(error);
  if (parsed.success) {
    return new Error(`${parsed.data.message} (request ${parsed.data.request_id})`);
  }
  if (typeof error === "string" && error.length > 0) return new Error(error);
  return new Error("API request failed");
}
