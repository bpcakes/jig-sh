import { useEffect, useState } from "react";
import { RefreshCwIcon, ServerIcon, SparklesIcon, TriangleAlertIcon } from "lucide-react";

import { type AppStatus, fetchAppStatus } from "@/api";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Skeleton } from "@/components/ui/skeleton";

type LoadState =
  | { phase: "loading" }
  | { phase: "ready"; status: AppStatus }
  | { phase: "error"; message: string };

export function App() {
  const [attempt, setAttempt] = useState(0);
  const [state, setState] = useState<LoadState>({ phase: "loading" });

  useEffect(() => {
    const controller = new AbortController();
    fetchAppStatus(controller.signal).then(
      (status) => setState({ phase: "ready", status }),
      (error: unknown) => {
        if (!controller.signal.aborted) {
          setState({
            phase: "error",
            message: error instanceof Error ? error.message : "Unknown API error",
          });
        }
      },
    );
    return () => controller.abort();
  }, [attempt]);

  return (
    <main className="min-h-svh bg-background text-foreground">
      <div className="mx-auto flex min-h-svh w-full max-w-5xl flex-col justify-center gap-10 px-6 py-16">
        <section className="max-w-3xl space-y-5">
          <Badge variant="outline" className="gap-1.5">
            <SparklesIcon /> <<[ subtitle ]>>
          </Badge>
          <div className="space-y-3">
            <h1 className="text-4xl font-semibold tracking-tight sm:text-6xl"><<[ title ]>></h1>
            <p className="max-w-2xl text-lg text-muted-foreground">
              A shadcn product surface with a working browser-to-Rust API slice, ready for the first feature.
            </p>
          </div>
        </section>

        {state.phase === "loading" && <StatusSkeleton />}
        {state.phase === "error" && (
          <Alert variant="destructive" className="max-w-3xl">
            <TriangleAlertIcon />
            <AlertTitle>Could not reach the application API</AlertTitle>
            <AlertDescription className="flex flex-col items-start gap-3">
              <span>{state.message}</span>
              <Button
                type="button"
                variant="outline"
                onClick={() => {
                  setState({ phase: "loading" });
                  setAttempt((value) => value + 1);
                }}
              >
                <RefreshCwIcon /> Retry
              </Button>
            </AlertDescription>
          </Alert>
        )}
        {state.phase === "ready" && <StatusCards status={state.status} />}

        <p className="text-sm text-muted-foreground">
          Generated with Jig · UI components are source-owned by this project.
        </p>
      </div>
    </main>
  );
}

function StatusSkeleton() {
  return (
    <section
      aria-label="Loading application status"
      className="grid max-w-3xl gap-4 sm:grid-cols-2"
    >
      <Skeleton className="h-36" />
      <Skeleton className="h-36" />
    </section>
  );
}

function StatusCards({ status }: { status: AppStatus }) {
  return (
    <section className="grid max-w-3xl gap-4 sm:grid-cols-2">
      <Card role="group" aria-labelledby="application-card-label">
        <CardHeader>
          <CardDescription id="application-card-label">Application</CardDescription>
          <CardTitle>{status.version.name}</CardTitle>
        </CardHeader>
        <CardContent className="text-sm text-muted-foreground">
          Version <span className="font-mono text-foreground">{status.version.version}</span>
        </CardContent>
      </Card>
      <Card role="group" aria-labelledby="service-status-card-label">
        <CardHeader className="flex flex-row items-center justify-between gap-3">
          <div>
            <CardDescription id="service-status-card-label">Rust API</CardDescription>
            <CardTitle>Service status</CardTitle>
          </div>
          <ServerIcon className="size-5 text-muted-foreground" />
        </CardHeader>
        <CardContent>
          <Badge variant={status.ready ? "default" : "secondary"}>
            {status.ready ? "Ready" : "Not ready"}
          </Badge>
        </CardContent>
      </Card>
    </section>
  );
}
