package httpapi

import (
	"bytes"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"os"
	"path/filepath"
	"testing"
)

func TestStatus(t *testing.T) {
	service := New(Dependencies{})
	request := httptest.NewRequest(http.MethodGet, "/api/status", nil)
	response := httptest.NewRecorder()

	service.Handler.ServeHTTP(response, request)

	if response.Code != http.StatusOK {
		t.Fatalf("status code = %d, want %d", response.Code, http.StatusOK)
	}
	if response.Header().Get("X-Request-ID") == "" {
		t.Fatal("X-Request-ID header is empty")
	}
	if link := response.Header().Get("Link"); link != "" {
		t.Fatalf("Link header = %q, want empty when schema routes are disabled", link)
	}
	var body map[string]any
	if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
		t.Fatalf("decode response: %v", err)
	}
	if schema, exists := body["$schema"]; exists {
		t.Fatalf("$schema = %v, want field omitted when schema routes are disabled", schema)
	}
	if body["ready"] != true {
		t.Fatalf("ready = %v, want true", body["ready"])
	}
}

func TestOpenAPIIsCurrent(t *testing.T) {
	service := New(Dependencies{})
	if service.API.OpenAPI().Info.Title != "<<[ repo_name ]>> API" {
		t.Fatalf("unexpected OpenAPI title %q", service.API.OpenAPI().Info.Title)
	}

	generated, err := json.MarshalIndent(service.API.OpenAPI(), "", "  ")
	if err != nil {
		t.Fatalf("encode OpenAPI: %v", err)
	}
	generated = append(generated, '\n')

	contractPath := filepath.FromSlash(<<[ go_public_openapi_test_path | tojson ]>>)
	committed, err := os.ReadFile(contractPath)
	if err != nil {
		t.Fatalf("read committed OpenAPI: %v", err)
	}
	if !bytes.Equal(committed, generated) {
		t.Fatal("public OpenAPI document is stale; run the contract:generate package script")
	}
}
