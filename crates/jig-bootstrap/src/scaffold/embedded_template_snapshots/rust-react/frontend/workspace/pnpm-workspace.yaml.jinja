packages:
[% for frontend in frontends %]
  - <<[ frontend.dir | tojson ]>>
[% endfor %]
  - "packages/public-api-client"
[% if admin_api_enabled %]
  - "packages/admin-api-client"
[% endif %]

# API clients are private workspace packages. Never fall back to fetching a
# same-named registry package when a local workspace package is available.
linkWorkspacePackages: true

# pnpm otherwise selects a different virtual-store setting in CI, which can
# make pre-run validation rewrite installed executable shims. Keep one layout.
enableGlobalVirtualStore: false

# esbuild needs its pinned install script to select the platform binary. Keep
# this allowlist narrow: each addition authorizes dependency code execution.
allowBuilds:
  esbuild: true

overrides:
  js-yaml: 4.3.1
