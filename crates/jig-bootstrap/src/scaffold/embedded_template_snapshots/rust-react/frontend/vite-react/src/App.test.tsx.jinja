import { QueryClient } from "@tanstack/react-query";
import {
  RouterProvider,
  createMemoryHistory,
} from "@tanstack/react-router";
import { fireEvent, render, screen, waitFor, within } from "@testing-library/react";
import { afterEach, expect, it, vi } from "vitest";

import { AppProviders } from "@/app/providers";
import { createAppRouter } from "@/app/router";

afterEach(() => vi.unstubAllGlobals());

function renderApp(initialEntry = "/") {
  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
      },
    },
  });
  const router = createAppRouter({
    history: createMemoryHistory({ initialEntries: [initialEntry] }),
    queryClient,
  });
  render(
    <AppProviders client={queryClient}>
      <RouterProvider router={router} />
    </AppProviders>,
  );

  return router;
}

function statusResponse(version = "0.1.0", ready = true) {
  return new Response(
    JSON.stringify({
      version: { name: "<<[ repo_name ]>>", version },
      ready,
    }),
    { status: 200, headers: { "Content-Type": "application/json" } },
  );
}

it("renders application status from the [% if backend_language == "go" %]Go[% else %]Rust[% endif %] API", async () => {
  vi.stubGlobal("fetch", vi.fn().mockResolvedValueOnce(statusResponse()));

  renderApp();
  expect(await screen.findByRole("heading", { name: "<<[ title ]>>" })).toBeDefined();
  expect(await screen.findByText("<<[ repo_name ]>>")).toBeDefined();
  expect(screen.getByText("0.1.0")).toBeDefined();
  const serviceStatusCard = screen.getByRole("group", { name: "[% if backend_language == "go" %]Go[% else %]Rust[% endif %] API" });
  expect(within(serviceStatusCard).getByText("Ready")).toBeDefined();
});

it("renders a connected API that is not ready", async () => {
  vi.stubGlobal("fetch", vi.fn().mockResolvedValueOnce(statusResponse("0.1.0", false)));

  renderApp();

  expect(await screen.findByText("Not ready")).toBeDefined();
});

it("shows invalid API responses and retries", async () => {
  const fetchMock = vi.fn()
    .mockResolvedValueOnce(new Response(JSON.stringify({ ready: true }), { status: 200, headers: { "Content-Type": "application/json" } }))
    .mockResolvedValueOnce(statusResponse("0.2.0"));
  vi.stubGlobal("fetch", fetchMock);

  renderApp();
  expect(await screen.findByText(/invalid input/i)).toBeDefined();
  fireEvent.click(screen.getByRole("button", { name: "Retry" }));
  expect(await screen.findByText("0.2.0")).toBeDefined();
  await waitFor(() => expect(fetchMock).toHaveBeenCalledTimes(2));
});

it("reports an unsuccessful API status response", async () => {
  vi.stubGlobal(
    "fetch",
    vi.fn().mockResolvedValueOnce(
      new Response(
        JSON.stringify({
[% if backend_language == "go" %]          title: "Service Unavailable",
          status: 503,
          detail: "A required dependency is unavailable",
[% else %]
          code: "dependency_unavailable",
          message: "A required dependency is unavailable",
          request_id: "request-public-503",
[% endif %]
        }),
        { status: 503, headers: { "Content-Type": "application/json" } },
      ),
    ),
  );

  renderApp();

  expect(
    await screen.findByText(/A required dependency is unavailable[% if backend_language == "rust" %] \(request request-public-503\)[% endif %]/i),
  ).toBeDefined();
});

it("preserves a plain-text upstream error", async () => {
  vi.stubGlobal(
    "fetch",
    vi.fn().mockResolvedValueOnce(new Response("Gateway timeout", { status: 504 })),
  );

  renderApp();

  expect(await screen.findByText("Gateway timeout")).toBeDefined();
});

it("uses a safe fallback for an unrecognized error body", async () => {
  vi.stubGlobal(
    "fetch",
    vi.fn().mockResolvedValueOnce(
      new Response(JSON.stringify({ internal: "must not be displayed" }), {
        status: 500,
        headers: { "Content-Type": "application/json" },
      }),
    ),
  );

  renderApp();

  expect(await screen.findByText("API request failed")).toBeDefined();
  expect(screen.queryByText(/must not be displayed/i)).toBeNull();
});

it("renders the not-found route and navigates home", async () => {
  vi.stubGlobal("fetch", vi.fn().mockResolvedValueOnce(statusResponse()));

  renderApp("/missing");

  expect(await screen.findByRole("heading", { name: "Page not found" })).toBeDefined();
  fireEvent.click(screen.getByRole("link", { name: "Return home" }));
  expect(await screen.findByText("<<[ repo_name ]>>")).toBeDefined();
});
