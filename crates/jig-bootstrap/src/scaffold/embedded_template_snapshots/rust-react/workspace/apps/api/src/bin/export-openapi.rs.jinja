use std::{fs, path::PathBuf, process::ExitCode};

use ::<<[ module_name ]>>_http as app_http_crate;
use anyhow::{Context, bail};

fn main() -> ExitCode {
    match run() {
        Ok(()) => ExitCode::SUCCESS,
        Err(error) => {
            eprintln!("OpenAPI export failed: {error:#}");
            ExitCode::FAILURE
        }
    }
}

fn run() -> anyhow::Result<()> {
    let path = parse_output_path()?.unwrap_or_else(|| {
        PathBuf::from(env!("CARGO_MANIFEST_DIR"))
            .join("../..")
            .join("openapi/public.json")
    });
    let contents = format!(
        "{}\n",
        serde_json::to_string_pretty(&app_http_crate::public_openapi())
            .context("Failed to serialize public OpenAPI document")?
    );
    if let Some(parent) = path.parent() {
        fs::create_dir_all(parent).with_context(|| {
            format!(
                "Failed to create public OpenAPI output directory {}",
                parent.display()
            )
        })?;
    }
    fs::write(&path, contents)
        .with_context(|| format!("Failed to write OpenAPI document to {}", path.display()))
}

fn parse_output_path() -> anyhow::Result<Option<PathBuf>> {
    let mut arguments = std::env::args_os().skip(1);
    match (arguments.next(), arguments.next(), arguments.next()) {
        (None, None, None) => Ok(None),
        (Some(flag), Some(path), None) if flag == "--output" => Ok(Some(path.into())),
        (Some(argument), _, trailing) => bail!(
            "unexpected argument {argument:?}{}; expected only --output <path>",
            if trailing.is_some() {
                " (and trailing arguments)"
            } else {
                ""
            }
        ),
        (None, Some(_), _) | (None, None, Some(_)) => {
            unreachable!("an iterator cannot yield a later argument first")
        }
    }
}
