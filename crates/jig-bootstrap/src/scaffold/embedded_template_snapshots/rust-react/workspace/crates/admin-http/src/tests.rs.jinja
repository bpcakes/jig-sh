use super::*;
use async_trait::async_trait;
use axum::{
    body::{Body, to_bytes},
    http::{Method, Request as HttpRequest, StatusCode, header},
    response::Response,
    routing::get,
};

#[derive(Clone, Copy)]
struct AllowAllAdminAuthorizer;

#[async_trait]
impl AdminAuthorizer for AllowAllAdminAuthorizer {
    async fn authorize(
        &self,
        _request: &AdminRequestContext,
    ) -> Result<(), AdminAuthorizationError> {
        Ok(())
    }
}

const AUTH_TEST_PATH: &str = "/admin-api/auth-test";

async fn test_client<A: AdminAuthorizer>(authorizer: A) -> InProcessClient {
    let router = Router::new().route(
        AUTH_TEST_PATH,
        get(|| async { StatusCode::NO_CONTENT }).post(|| async { StatusCode::NO_CONTENT }),
    );
    in_process_routes(
        AppState::new(),
        authorizer,
        router,
        RouteInventory::new([AUTH_TEST_PATH]).unwrap(),
    )
    .await
    .expect("test routes assemble")
}

async fn send(
    client: &InProcessClient,
    method: Method,
    uri: &str,
    headers: &[(&str, &str)],
) -> Response {
    let mut request = HttpRequest::builder().method(method).uri(uri);
    for (name, value) in headers {
        request = request.header(*name, *value);
    }
    client.request(request.body(Body::empty()).unwrap()).await
}

async fn json(response: Response) -> serde_json::Value {
    serde_json::from_slice(&to_bytes(response.into_body(), usize::MAX).await.unwrap()).unwrap()
}

fn assert_private(response: &Response) {
    assert_eq!(response.headers()[header::CACHE_CONTROL], "no-store");
    assert_eq!(response.headers()[header::REFERRER_POLICY], "no-referrer");
    assert_eq!(
        response.headers()[header::X_CONTENT_TYPE_OPTIONS],
        "nosniff"
    );
}

#[tokio::test]
async fn deny_all_authorizer_returns_standard_error_with_request_id() {
    let client = test_client(DenyAllAdminAuthorizer).await;
    let response = send(&client, Method::GET, AUTH_TEST_PATH, &[]).await;

    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
    assert_private(&response);
    let response_request_id = response.headers()["x-request-id"]
        .to_str()
        .unwrap()
        .to_owned();
    let body = json(response).await;
    assert_eq!(body["code"], "unauthorized");
    assert_eq!(body["request_id"], response_request_id);
}

#[tokio::test]
async fn explicit_authorizer_can_admit_a_matched_route() {
    let client = test_client(AllowAllAdminAuthorizer).await;
    let response = send(&client, Method::GET, AUTH_TEST_PATH, &[]).await;

    assert_eq!(response.status(), StatusCode::NO_CONTENT);
    assert_private(&response);
}

#[tokio::test]
async fn admin_status_is_protected_and_reflects_readiness_after_authorization() {
    let denied = in_process(AppState::new(), DenyAllAdminAuthorizer)
        .await
        .unwrap();
    let response = send(&denied, Method::GET, "/admin-api/status", &[]).await;
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);

    let state = AppState::new();
    let expected_ready = state.is_ready();
    let allowed = in_process(state, AllowAllAdminAuthorizer).await.unwrap();
    let response = send(&allowed, Method::GET, "/admin-api/status", &[]).await;
    assert_eq!(response.status(), StatusCode::OK);
    assert_eq!(json(response).await["ready"], expected_ready);
}

#[tokio::test]
async fn unknown_admin_paths_remain_not_found_without_authorization_challenge() {
    let client = test_client(DenyAllAdminAuthorizer).await;
    let response = send(&client, Method::GET, "/admin-api/unknown", &[]).await;

    assert_eq!(response.status(), StatusCode::NOT_FOUND);
    assert_private(&response);
}

#[tokio::test]
async fn probes_answer_outside_authorization_with_private_headers() {
    let client = test_client(DenyAllAdminAuthorizer).await;
    let live = send(&client, Method::GET, "/health/live", &[]).await;
    assert_eq!(live.status(), StatusCode::OK);
    assert_private(&live);

    let rejected_method = send(&client, Method::POST, "/health/live", &[]).await;
    assert_eq!(rejected_method.status(), StatusCode::METHOD_NOT_ALLOWED);
    assert_private(&rejected_method);
}

#[tokio::test]
async fn mutations_require_same_origin_fetch_metadata_and_the_admin_marker() {
    let client = test_client(AllowAllAdminAuthorizer).await;

    let cross_site = send(
        &client,
        Method::POST,
        AUTH_TEST_PATH,
        &[
            ("sec-fetch-site", "cross-site"),
            (ADMIN_REQUEST_HEADER, "1"),
        ],
    )
    .await;
    assert_eq!(cross_site.status(), StatusCode::FORBIDDEN);
    assert_private(&cross_site);
    let request_id = cross_site.headers()["x-request-id"]
        .to_str()
        .unwrap()
        .to_owned();
    let body = json(cross_site).await;
    assert_eq!(body["code"], "fetch_site_cross_site");
    assert_eq!(body["request_id"], request_id);

    let unmarked = send(
        &client,
        Method::POST,
        AUTH_TEST_PATH,
        &[("sec-fetch-site", "same-origin")],
    )
    .await;
    assert_eq!(unmarked.status(), StatusCode::FORBIDDEN);
    assert_eq!(json(unmarked).await["code"], "required_header_missing");

    let marked = send(
        &client,
        Method::POST,
        AUTH_TEST_PATH,
        &[
            ("sec-fetch-site", "same-origin"),
            (ADMIN_REQUEST_HEADER, ADMIN_REQUEST_HEADER_VALUE),
        ],
    )
    .await;
    assert_eq!(marked.status(), StatusCode::NO_CONTENT);
}

#[test]
fn committed_admin_openapi_is_current() {
    let actual = format!(
        "{}\n",
        serde_json::to_string_pretty(&openapi()).expect("OpenAPI document serializes")
    );
    let expected = include_str!(concat!(
        env!("CARGO_MANIFEST_DIR"),
        "/../../openapi/admin.json"
    ));
    assert_eq!(
        actual, expected,
        "admin OpenAPI document is stale; run the contract:generate package script"
    );
}
