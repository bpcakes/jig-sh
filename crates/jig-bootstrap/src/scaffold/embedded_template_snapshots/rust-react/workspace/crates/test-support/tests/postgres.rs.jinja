use std::{io, time::Duration};

use ::<<[ module_name ]>> as app_crate;
[% if jobs_enabled %]
use ::<<[ module_name ]>>_db as app_db_crate;
use ::<<[ module_name ]>>_jobs as jobs_crate;
[% endif %]
use ::<<[ module_name ]>>_test_support::TestApp;
use ::<<[ module_name ]>>_test_support::db::with_migrated_database;
use anyhow::Context;
use axum::http::StatusCode;
use batter::{
    cleanup::CleanupBudget,
    lifecycle::{ShutdownBudget, Supervisor},
    operation::OperationOwner,
    startup::Startup,
};

fn cleanup_budget() -> anyhow::Result<CleanupBudget> {
    Ok(CleanupBudget::new(
        Duration::from_secs(1),
        Duration::from_secs(1),
        Duration::from_secs(1),
    )?)
}

fn shutdown_budget() -> anyhow::Result<ShutdownBudget> {
    Ok(ShutdownBudget::new(
        Duration::from_secs(5),
        Duration::from_secs(1),
        Duration::from_secs(1),
        cleanup_budget()?,
    )?)
}

#[tokio::test]
#[ignore = "run with the root test:postgres package script"]
async fn migrated_database_is_ready_through_the_public_boundary() -> anyhow::Result<()> {
    with_migrated_database(|db| async move {
        let context = OperationOwner::new(Duration::from_secs(5))?.into_context();
        batter::sqlx::probe(db.pool(), &context).await?;
        let _applied: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM _sqlx_migrations")
            .fetch_one(db.pool())
            .await?;

        let state = app_crate::AppState::from_database(app_crate::AppConfig::for_tests(), db);
        let app = TestApp::from_state(state).await;
        app.get("/health/ready").await.assert_status(StatusCode::OK);
        let status: serde_json::Value = app.get_json("/api/status").await;
        assert_eq!(status["ready"], true);
        Ok(())
    })
    .await
}

#[tokio::test]
#[ignore = "run with the root test:postgres package script"]
async fn health_monitor_observes_the_database_under_supervision() -> anyhow::Result<()> {
    with_migrated_database(|db| async move {
        let (publish, published) = tokio::sync::oneshot::channel();
        let monitored = db.clone();
        let mut starting = Startup::scoped(
            Supervisor::new(shutdown_budget()?),
            OperationOwner::new(Duration::from_secs(10))?.into_context(),
            cleanup_budget()?,
            move |scope| {
                Box::pin(async move {
                    let health = monitored
                        .register_health(scope.registration())
                        .map_err(io::Error::other)?;
                    let _ = publish.send(health);
                    Ok::<_, io::Error>(())
                })
            },
        )
        .start();
        let running = starting.wait().await?;
        let health = published.await?;
        let observed = tokio::time::timeout(Duration::from_secs(10), async {
            while !health.is_healthy() {
                tokio::time::sleep(Duration::from_millis(50)).await;
            }
        })
        .await;
        let shutdown = running.shutdown_checked().await;
        observed.context("the health monitor did not observe a healthy database")?;
        shutdown?;
        Ok(())
    })
    .await
}
