#[tokio::test]
#[ignore = "run with the root test:postgres package script"]
async fn example_job_runs_under_the_supervised_worker() -> anyhow::Result<()> {
    with_migrated_database(|db| async move {
        let worker_db = db.clone();
        let mut starting = Startup::scoped(
            Supervisor::new(shutdown_budget()?),
            OperationOwner::new(Duration::from_secs(30))?.into_context(),
            cleanup_budget()?,
            move |scope| {
                Box::pin(async move {
                    let startup = OperationOwner::new(Duration::from_secs(10))
                        .map_err(io::Error::other)?
                        .into_context();
                    jobs_crate::register(scope, &worker_db, Some("worker-test"), &startup)
                        .await
                        .map_err(io::Error::other)
                })
            },
        )
        .start();
        let running = starting.wait().await?;
        let executed = async {
            running.status().wait_ready().await.map_err(|readiness| {
                anyhow::anyhow!("worker did not become ready: {readiness:?}")
            })?;
            jobs_crate::enqueue_example(&db, "hello from the worker test", "worker-test-1").await?;
            wait_for_job(&db, "worker-test-1", "SUCCEEDED").await
        }
        .await;
        let shutdown = running.shutdown_checked().await;
        executed?;
        shutdown?;
        Ok(())
    })
    .await
}

async fn wait_for_job(db: &app_db_crate::Db, key: &str, expected: &str) -> anyhow::Result<()> {
    tokio::time::timeout(Duration::from_secs(30), async {
        loop {
            let status: Option<String> =
                sqlx::query_scalar("SELECT status::text FROM job_queue WHERE idempotency_key = $1")
                    .bind(key)
                    .fetch_optional(db.pool())
                    .await?;
            if status.as_deref() == Some(expected) {
                return Ok::<_, anyhow::Error>(());
            }
            tokio::time::sleep(Duration::from_millis(100)).await;
        }
    })
    .await
    .context("the example job did not reach its expected status")?
}
[% endif %]
