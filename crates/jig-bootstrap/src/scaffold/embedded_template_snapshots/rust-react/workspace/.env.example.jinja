BIND_ADDR=127.0.0.1:3000
RUST_LOG=<<[ module_name ]>>=info,<<[ module_name ]>>_api=info[% if admin_api_enabled %],<<[ module_name ]>>_admin_api=info[% endif %],batter=info,batter_axum=info<<[ ",runledger=info" if jobs_enabled else "" ]>>
[% if db_enabled -%]
DATABASE_URL=<<[ database_url_example ]>>
[% endif -%]
[% if metrics_enabled -%]
# Export Batter's bounded metrics catalog to an OTLP/HTTP collector, for example
# METRICS_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/metrics
[% endif -%]
[% if jobs_enabled -%]
# Stable Runledger worker identity; unset derives a unique one per process.
# JOBS_WORKER_ID=
[% endif -%]
