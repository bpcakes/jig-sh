{
  "$id": "https://raw.githubusercontent.com/bpcakes/jig-sh/master/crates/jig-contract/contracts/status-provider/v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jig status-provider report v1",
  "description": "Root document emitted by a status provider.",
  "type": "object",
  "properties": {
    "diagnostics": {
      "description": "Provider-level information that does not belong to one work package.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "extensions": {
      "description": "Namespaced provider-specific data preserved by generic consumers.",
      "type": "object",
      "additionalProperties": true
    },
    "inputs": {
      "description": "Source inputs and revisions inspected by the provider.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Input"
      }
    },
    "observed_at_ms": {
      "description": "Unix timestamp in milliseconds when the observation completed.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "outcome": {
      "description": "Whether every intended observation completed.",
      "$ref": "#/$defs/Outcome"
    },
    "protocol": {
      "description": "Protocol discriminator. For this type it must be `jig.status-provider/v1`.",
      "$ref": "#/$defs/Protocol"
    },
    "provider": {
      "description": "Stable provider identity and independently versioned implementation.",
      "$ref": "#/$defs/Provider"
    },
    "work_packages": {
      "description": "Software-rewrite work packages observed by the provider.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkPackage"
      }
    }
  },
  "required": [
    "protocol",
    "provider",
    "observed_at_ms",
    "outcome"
  ],
  "$defs": {
    "AcceptanceCheck": {
      "description": "Status of one numbered work-package acceptance check.",
      "type": "object",
      "properties": {
        "category": {
          "description": "Cross-provider normalized category.",
          "$ref": "#/$defs/Category"
        },
        "id": {
          "description": "Optional stable check id.",
          "type": [
            "string",
            "null"
          ]
        },
        "ordinal": {
          "description": "One-based ordinal from the work-package specification.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source": {
          "description": "Source document location declaring the check.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "description": "Provider-native stable state token.",
          "type": "string"
        },
        "target": {
          "description": "Executable test target or other evidence target.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ordinal",
        "state",
        "category"
      ]
    },
    "Blocker": {
      "description": "A domain condition that prevents a work package from advancing.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable machine-readable blocker code.",
          "type": "string"
        },
        "message": {
          "description": "Human-facing explanation.",
          "type": "string"
        },
        "related_work_package": {
          "description": "Related work-package id when another package causes the blocker.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Source location supporting the blocker.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "Category": {
      "description": "Small shared state vocabulary used for generic rendering and aggregation.",
      "oneOf": [
        {
          "description": "The provider could not determine a state.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "Work has not reached a ready or active state.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Work is eligible to advance within this facet.",
          "type": "string",
          "const": "ready"
        },
        {
          "description": "Work is currently underway.",
          "type": "string",
          "const": "active"
        },
        {
          "description": "Work cannot advance within this facet.",
          "type": "string",
          "const": "blocked"
        },
        {
          "description": "Work completed successfully within this facet.",
          "type": "string",
          "const": "complete"
        },
        {
          "description": "Work completed unsuccessfully or is invalid.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "Diagnostic": {
      "description": "Provider-level information, warning, or error.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable machine-readable diagnostic code.",
          "type": "string"
        },
        "level": {
          "description": "Diagnostic importance.",
          "$ref": "#/$defs/DiagnosticLevel"
        },
        "message": {
          "description": "Human-facing explanation.",
          "type": "string"
        },
        "source": {
          "description": "Source location associated with the diagnostic.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "work_package": {
          "description": "Related work-package id when applicable.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "level",
        "message"
      ]
    },
    "DiagnosticLevel": {
      "description": "Importance of a provider-level diagnostic.",
      "oneOf": [
        {
          "description": "Informational detail.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Degraded or suspicious state that does not invalidate the report.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "An observation failed; a partial report may still be trustworthy.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "Evidence": {
      "description": "Reference to evidence without embedding large or sensitive contents.",
      "type": "object",
      "properties": {
        "digest": {
          "description": "Optional digest of the referenced evidence.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Evidence kind, such as `test`, `receipt`, or `legacy_source`.",
          "type": "string"
        },
        "reference": {
          "description": "Stable test target, receipt id, or other reference.",
          "type": "string"
        },
        "source": {
          "description": "Source location associated with the evidence.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "reference"
      ]
    },
    "Facet": {
      "description": "One independent status dimension for a work package.",
      "type": "object",
      "properties": {
        "category": {
          "description": "Cross-provider normalized category.",
          "$ref": "#/$defs/Category"
        },
        "digest": {
          "description": "Specification or progress digest used to detect stale state.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Source document location supporting the state.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "description": "Provider-native stable state token.",
          "type": "string"
        },
        "summary": {
          "description": "Optional human-facing explanation.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "category"
      ]
    },
    "Input": {
      "description": "A source input inspected by the provider.",
      "type": "object",
      "properties": {
        "digest": {
          "description": "Content or configuration digest used to detect stale observations.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Input kind, such as `git`, `document_catalog`, or `database_schema`.",
          "type": "string"
        },
        "name": {
          "description": "Stable name within this report, such as `target` or `legacy`.",
          "type": "string"
        },
        "path": {
          "description": "Repository-relative input path when the input is inside the target checkout.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "Exact source revision when the input has revision identity.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "kind"
      ]
    },
    "Outcome": {
      "description": "Completeness of an otherwise valid provider observation.",
      "oneOf": [
        {
          "description": "Every intended observation completed.",
          "type": "string",
          "const": "complete"
        },
        {
          "description": "The report is trustworthy, but one or more observations were unavailable.",
          "type": "string",
          "const": "partial"
        }
      ]
    },
    "Protocol": {
      "description": "Literal protocol discriminator for a v1 report.",
      "oneOf": [
        {
          "description": "`jig.status-provider/v1`.",
          "type": "string",
          "const": "jig.status-provider/v1"
        }
      ]
    },
    "Provider": {
      "description": "Identity of the provider implementation.",
      "type": "object",
      "properties": {
        "adapter_version": {
          "description": "Provider implementation version, independent of the protocol version.",
          "type": "string"
        },
        "display_name": {
          "description": "Optional human-facing name.",
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "description": "Namespaced provider-specific identity data.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Stable, globally recognizable provider id.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "adapter_version"
      ]
    },
    "SourceLocation": {
      "description": "Repository-relative source location supporting an observation.",
      "type": "object",
      "properties": {
        "column": {
          "description": "Optional one-based column number.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "line": {
          "description": "Optional one-based line number.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "description": "Forward-slash repository-relative path.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ]
    },
    "WorkPackage": {
      "description": "Status observation for one software-rewrite work package.",
      "type": "object",
      "properties": {
        "acceptance_checks": {
          "description": "Ordered acceptance checks declared for this package.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcceptanceCheck"
          }
        },
        "blockers": {
          "description": "Domain blockers discovered by the provider.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Blocker"
          }
        },
        "dependencies": {
          "description": "Work-package ids that this package depends on.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "description": "Evidence references supporting the observation.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "extensions": {
          "description": "Namespaced provider-specific package data.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Stable work-package id.",
          "type": "string"
        },
        "implementation": {
          "description": "Implementation progress observed by the provider.",
          "$ref": "#/$defs/Facet"
        },
        "specification": {
          "description": "Specification readiness observed by the provider.",
          "$ref": "#/$defs/Facet"
        },
        "title": {
          "description": "Optional human-facing title.",
          "type": [
            "string",
            "null"
          ]
        },
        "verification": {
          "description": "Verification progress observed by the provider.",
          "$ref": "#/$defs/Facet"
        }
      },
      "required": [
        "id",
        "specification",
        "implementation",
        "verification"
      ]
    }
  }
}
