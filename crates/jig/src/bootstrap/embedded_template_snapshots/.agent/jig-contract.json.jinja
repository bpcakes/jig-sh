{
  "contract_version": <<[ _jig.contract_version ]>>,
  "tool_namespace": "jig",
[% if _jig.contract_version >= 6 %]
  "required_commands": <<[ repository.required_commands | tojson(indent=2) ]>>,
  "tools": <<[ repository.tools | tojson(indent=2) ]>>,
  "components": <<[ repository.components | tojson(indent=2) ]>>,
  "actions": <<[ repository.actions | tojson(indent=2) ]>>,
  "profiles": <<[ repository.profiles | tojson(indent=2) ]>>,
  "default_check_profile": <<[ repository.default_check_profile | tojson ]>>
[% else %]
  "required_commands": [
    "bootstrap_command",
[% if backend_language == "rust" %]    "rust_fmt_check_command",
    "rust_clippy_command",
    "rust_test_command",
    "rust_test_locked_command"[% else %]    "go_fmt_check_command",
    "go_lint_command",
    "go_test_command",
    "go_test_locked_command"[% if go_database == "postgres" %],
    "sqlc_check_command"[% endif %][% endif %][% if frontend_harness_enabled %],
    "typescript_lint_command",
    "typescript_typecheck_command",
    "typescript_build_command",
    "typescript_coverage_command"[% endif %][% if sqlx_enabled %],
    "sqlx_check_command"[% endif %][% if sqlx_enabled and schema_dump_enabled %],
    "schema_dump_command"[% endif %]
  ],
  "tools": [
    {
      "name": "jig.bootstrap",
      "kind": "command",
      "description": "Run the configured project bootstrap command.",
      "command": "bootstrap_command"
    },
    {
      "name": "jig.fmt_check",
      "kind": "command",
      "description": "Run the configured format check command.",
      "command": "[% if backend_language == "go" %]go_fmt_check_command[% else %]rust_fmt_check_command[% endif %]"
    },
[% if backend_language == "go" %]
    {
      "name": "jig.lint",
      "kind": "command",
      "description": "Run the configured Go lint command.",
      "command": "go_lint_command"
    },
[% else %]
    {
      "name": "jig.clippy",
      "kind": "command",
      "description": "Run the configured clippy command.",
      "command": "rust_clippy_command"
    },
[% endif %]
    {
      "name": "jig.test",
      "kind": "command",
      "description": "Run the configured default test command.",
      "command": "[% if backend_language == "go" %]go_test_command[% else %]rust_test_command[% endif %]"
    },
    {
      "name": "jig.test_locked",
      "kind": "command",
      "description": "Run the configured locked test command.",
      "command": "[% if backend_language == "go" %]go_test_locked_command[% else %]rust_test_locked_command[% endif %]"
    },
[% if frontend_harness_enabled %]
    {
      "name": "jig.typescript_lint",
      "kind": "command",
      "description": "Run the configured TypeScript lint command.",
      "command": "typescript_lint_command"
    },
    {
      "name": "jig.typescript_typecheck",
      "kind": "command",
      "description": "Run the configured TypeScript typecheck command.",
      "command": "typescript_typecheck_command"
    },
    {
      "name": "jig.typescript_build",
      "kind": "command",
      "description": "Run the configured TypeScript build command.",
      "command": "typescript_build_command"
    },
    {
      "name": "jig.typescript_coverage",
      "kind": "command",
      "description": "Run the configured TypeScript coverage command.",
      "command": "typescript_coverage_command"
    },
[% endif %]
[% if sqlx_enabled %]
[% if schema_dump_enabled %]
    {
      "name": "jig.schema_check",
      "kind": "native",
      "description": "Run the native schema drift check."
    },
    {
      "name": "jig.schema_dump",
      "kind": "command",
      "description": "Run the configured schema dump command.",
      "command": "schema_dump_command"
    },
[% endif %]
    {
      "name": "jig.sqlx_check",
      "kind": "command",
      "description": "Run the configured SQLx check command.",
      "command": "sqlx_check_command"
    },
[% endif %]
[% if sqlx_enabled or (backend_language == "go" and go_database == "postgres") %]
    {
      "name": "jig.migration_add",
      "kind": "native",
      "description": "Add a backend-compatible timestamped SQL migration."
    },
[% endif %]
[% if backend_language == "go" and go_database == "postgres" %]
    {
      "name": "jig.sqlc_check",
      "kind": "command",
      "description": "Run the configured sqlc drift check.",
      "command": "sqlc_check_command"
    },
[% endif %]
    {
      "name": "jig.contract_check",
      "kind": "native",
      "description": "Run the native Jig contract check."
    }
  ]
[% endif %]
}
