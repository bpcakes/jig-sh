package database

import (
	"context"
	"database/sql"
	"embed"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/jackc/pgx/v5/pgxpool"
	"github.com/jackc/pgx/v5/stdlib"
	"github.com/pressly/goose/v3"
)

//go:embed migrations/*.sql
var migrations embed.FS

func Bootstrap(ctx context.Context, databaseURL string) error {
	config, err := pgx.ParseConfig(databaseURL)
	if err != nil {
		return fmt.Errorf("parse DATABASE_URL: %w", err)
	}
	if config.Database == "" {
		return fmt.Errorf("DATABASE_URL must name a PostgreSQL database")
	}
	targetDatabase := config.Database
	maintenanceConfig := config.Copy()
	maintenanceConfig.Database = "postgres"
	maintenance, err := pgx.ConnectConfig(ctx, maintenanceConfig)
	if err != nil {
		return fmt.Errorf("connect to PostgreSQL maintenance database: %w", err)
	}
	defer maintenance.Close(ctx)

	var exists bool
	if err := maintenance.QueryRow(
		ctx,
		"SELECT EXISTS (SELECT 1 FROM pg_database WHERE datname = $1)",
		targetDatabase,
	).Scan(&exists); err != nil {
		return fmt.Errorf("check PostgreSQL database %q: %w", targetDatabase, err)
	}
	if !exists {
		_, err = maintenance.Exec(
			ctx,
			"CREATE DATABASE "+pgx.Identifier{targetDatabase}.Sanitize(),
		)
		var postgresError *pgconn.PgError
		if err != nil && (!errors.As(err, &postgresError) || postgresError.Code != "42P04") {
			return fmt.Errorf("create PostgreSQL database %q: %w", targetDatabase, err)
		}
	}

	if err := migrate(ctx, databaseURL); err != nil {
		return err
	}
	pool, err := Open(ctx, databaseURL)
	if err != nil {
		return err
	}
	pool.Close()
	return nil
}

func Open(ctx context.Context, databaseURL string) (*pgxpool.Pool, error) {
	pool, err := pgxpool.New(ctx, databaseURL)
	if err != nil {
		return nil, fmt.Errorf("create PostgreSQL pool: %w", err)
	}
	if err := pool.Ping(ctx); err != nil {
		pool.Close()
		return nil, fmt.Errorf("ping PostgreSQL: %w", err)
	}
	return pool, nil
}

func migrate(ctx context.Context, databaseURL string) error {
	config, err := pgx.ParseConfig(databaseURL)
	if err != nil {
		return fmt.Errorf("parse DATABASE_URL: %w", err)
	}
	var db *sql.DB = stdlib.OpenDB(*config)
	defer db.Close()
	if err := goose.SetDialect("postgres"); err != nil {
		return fmt.Errorf("configure Goose: %w", err)
	}
	goose.SetBaseFS(migrations)
	if err := goose.UpContext(ctx, db, "migrations"); err != nil {
		return fmt.Errorf("apply Goose migrations: %w", err)
	}
	return nil
}
