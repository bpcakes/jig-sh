use std::process::ExitCode;

use ::<<[ module_name ]>> as app_crate;
use ::<<[ module_name ]>>_http as app_http_crate;
use ::<<[ module_name ]>>_runtime as runtime;
use anyhow::Context;

#[tokio::main]
async fn main() -> ExitCode {
    load_dotenv();
    init_tracing();
    install_panic_hook();

    match run().await {
        Ok(()) => ExitCode::SUCCESS,
        Err(error) => {
            tracing::error!(error = ?error, "API server failed");
            ExitCode::FAILURE
        }
    }
}

fn load_dotenv() {
    match dotenvy::dotenv() {
        Ok(_) => {}
        Err(dotenvy::Error::Io(error)) if error.kind() == std::io::ErrorKind::NotFound => {}
        Err(error) => eprintln!("warning: failed to load .env: {error}"),
    }
}

async fn run() -> anyhow::Result<()> {
[% if db_enabled %]
    let command = parse_command()?;
[% else %]
    parse_command()?;
[% endif %]
    let config = app_crate::AppConfig::from_env().context("Failed to load application config")?;
[% if db_enabled %]
    if command == Command::BootstrapDatabase {
        let created = runtime::bootstrap_database(config)
            .await
            .context("Failed to bootstrap the database")?;
        if created {
            tracing::info!("created database and applied migrations");
        } else {
            tracing::info!("database already exists; applied migrations");
        }
        return Ok(());
    }
[% endif %]
    runtime::serve(config, app_http_crate::router_with_shutdown).await
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
enum Command {
    Serve,
[% if db_enabled %]
    BootstrapDatabase,
[% endif %]
}

fn parse_command() -> anyhow::Result<Command> {
    let mut arguments = std::env::args_os().skip(1);
    match (arguments.next(), arguments.next()) {
        (None, None) => Ok(Command::Serve),
[% if db_enabled %]
        (Some(argument), None) if argument == "--bootstrap-database" => {
            Ok(Command::BootstrapDatabase)
        }
[% endif %]
        (Some(argument), trailing) => anyhow::bail!(
            "unexpected API argument {argument:?}{}",
            if trailing.is_some() {
                " (and trailing arguments)"
            } else {
                ""
            }
        ),
        (None, Some(_)) => {
            unreachable!("an iterator cannot yield a second argument without a first")
        }
    }
}

fn init_tracing() {
    #[allow(clippy::useless_concat)]
    let default_filter = concat!(
        // Renderer-controlled values vary in length, so keep this rustfmt-stable shape.
        "<<[ module_name ]>>=info,",
        "<<[ module_name ]>>_api=info,",
        "tower_http=info",
        ",batter=info,batter_axum=info",
    );
    tracing_subscriber::fmt()
        .with_env_filter(
            // If you rename the application library or API binary, update this filter too.
            std::env::var("RUST_LOG").unwrap_or_else(|_| default_filter.into()),
        )
        .init();
}

fn install_panic_hook() {
    let default_hook = std::panic::take_hook();
    std::panic::set_hook(Box::new(move |panic_info| {
        tracing::error!(panic = %panic_info, "application panic");
        default_hook(panic_info);
    }));
}
