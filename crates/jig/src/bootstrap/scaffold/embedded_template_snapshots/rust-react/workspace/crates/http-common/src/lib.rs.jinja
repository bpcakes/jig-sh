pub mod requests;

use axum::{
    Extension, Json,
    http::StatusCode,
    response::{IntoResponse, Response},
};
use batter_axum::CorrelationId;
use serde::Serialize;
use utoipa::ToSchema;

#[derive(Clone, Debug, Eq, PartialEq, Serialize, ToSchema)]
pub struct ApiErrorResponse {
    /// Stable machine-readable identifier suitable for client branching.
    pub code: String,
    /// Safe user-facing description. Internal error details belong in logs.
    pub message: String,
    /// Correlates this response with server logs.
    pub request_id: String,
}

#[derive(Clone, Debug)]
pub struct ApiError {
    status: StatusCode,
    body: ApiErrorResponse,
}

impl ApiError {
    pub fn new(
        status: StatusCode,
        code: &'static str,
        message: &'static str,
        correlation_id: Option<&CorrelationId>,
    ) -> Self {
        Self {
            status,
            body: ApiErrorResponse {
                code: code.to_owned(),
                message: message.to_owned(),
                request_id: request_id(correlation_id),
            },
        }
    }

    pub fn not_found(correlation_id: Option<&CorrelationId>) -> Self {
        Self::new(
            StatusCode::NOT_FOUND,
            "not_found",
            "The requested resource was not found",
            correlation_id,
        )
    }

    pub fn service_unavailable(
        code: &'static str,
        message: &'static str,
        correlation_id: Option<&CorrelationId>,
    ) -> Self {
        Self::new(
            StatusCode::SERVICE_UNAVAILABLE,
            code,
            message,
            correlation_id,
        )
    }

    pub fn unauthorized(correlation_id: Option<&CorrelationId>) -> Self {
        Self::new(
            StatusCode::UNAUTHORIZED,
            "unauthorized",
            "Authentication is required",
            correlation_id,
        )
    }

    pub fn forbidden(correlation_id: Option<&CorrelationId>) -> Self {
        Self::new(
            StatusCode::FORBIDDEN,
            "forbidden",
            "You are not authorized to perform this operation",
            correlation_id,
        )
    }

    pub fn conflict(
        code: &'static str,
        message: &'static str,
        correlation_id: Option<&CorrelationId>,
    ) -> Self {
        Self::new(StatusCode::CONFLICT, code, message, correlation_id)
    }

    pub fn validation(
        code: &'static str,
        message: &'static str,
        correlation_id: Option<&CorrelationId>,
    ) -> Self {
        Self::new(
            StatusCode::UNPROCESSABLE_ENTITY,
            code,
            message,
            correlation_id,
        )
    }
}

impl IntoResponse for ApiError {
    fn into_response(self) -> Response {
        (self.status, Json(self.body)).into_response()
    }
}

pub async fn not_found(Extension(correlation_id): Extension<CorrelationId>) -> ApiError {
    ApiError::not_found(Some(&correlation_id))
}

fn request_id(correlation_id: Option<&CorrelationId>) -> String {
    correlation_id
        .map(CorrelationId::as_str)
        .unwrap_or("unknown")
        .to_owned()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn errors_do_not_invent_request_ids_without_typed_context() {
        let error = ApiError::service_unavailable(
            "dependency_unavailable",
            "A required dependency is unavailable",
            None,
        );

        assert_eq!(error.status, StatusCode::SERVICE_UNAVAILABLE);
        assert_eq!(error.body.code, "dependency_unavailable");
        assert_eq!(error.body.request_id, "unknown");
    }
}
