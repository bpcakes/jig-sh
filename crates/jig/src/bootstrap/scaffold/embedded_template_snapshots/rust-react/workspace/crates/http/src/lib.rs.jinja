mod public;

use ::<<[ module_name ]>>::AppState;
use ::<<[ module_name ]>>_http_common::REQUEST_ID_HEADER;
use ::<<[ module_name ]>>_http_common::not_found;
use axum::Router;
use batter::lifecycle::ShutdownHandle;
use tower_http::request_id::{MakeRequestUuid, PropagateRequestIdLayer, SetRequestIdLayer};
use utoipa::openapi::OpenApi;

pub fn router(state: AppState) -> Router {
    let shutdown = ShutdownHandle::new();
    shutdown.mark_ready();
    router_with_shutdown(state, shutdown)
}

pub fn router_with_shutdown(state: AppState, shutdown: ShutdownHandle) -> Router {
    let router = public::operational_routes(shutdown).fallback(not_found);

    router
        .with_state(state)
        .layer(axum::middleware::from_fn(batter_axum::observe_http))
        .layer(PropagateRequestIdLayer::new(REQUEST_ID_HEADER))
        .layer(SetRequestIdLayer::new(REQUEST_ID_HEADER, MakeRequestUuid))
}

pub fn public_openapi() -> OpenApi {
    public::routes().into_openapi()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn committed_public_openapi_is_current() {
        assert_document_matches(
            public_openapi(),
            include_str!(concat!(
                env!("CARGO_MANIFEST_DIR"),
                "/../../openapi/public.json"
            )),
            "public",
        );
    }

    fn assert_document_matches(document: OpenApi, expected: &str, name: &str) {
        let actual = format!(
            "{}\n",
            serde_json::to_string_pretty(&document).expect("OpenAPI document serializes")
        );
        assert_eq!(
            actual, expected,
            "{name} OpenAPI document is stale; run the contract:generate package script"
        );
    }
}
