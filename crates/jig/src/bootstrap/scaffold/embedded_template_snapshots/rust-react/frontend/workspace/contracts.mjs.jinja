import { execFile, spawn } from "node:child_process";
import { promisify } from "node:util";
import {
  lstat,
  mkdir,
  mkdtemp,
  readFile,
  readdir,
  rename,
  rm,
} from "node:fs/promises";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";

import { createClient } from "@hey-api/openapi-ts";

const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const execFileAsync = promisify(execFile);
process.chdir(repoRoot);

const sharedPlugins = [
  { name: "@hey-api/client-fetch", bundle: true },
  "zod",
  { name: "@hey-api/sdk", validator: true },
  "@tanstack/react-query",
];
const contracts = [
  {
    name: "public",
    cargoPackage: "<<[ package_name ]>>-api",
    document: "openapi/public.json",
    generated: "packages/public-api-client/src/generated",
  },
[% if admin_api_enabled %]
  {
    name: "admin",
    cargoPackage: "<<[ package_name ]>>-admin-api",
    document: "openapi/admin.json",
    generated: "packages/admin-api-client/src/generated",
  },
[% endif %]
];
const publicFrontendDirs = [[% for dir in public_frontend_dirs %]<<[ dir | tojson ]>>[% if not loop.last %], [% endif %][% endfor %]];
const forbiddenPublicMarkers = [
  "<<[ package_name ]>>-admin-api-client",
  "<<[ package_name ]>>-admin-http",
  "<<[ package_name ]>>-admin-api",
  "openapi/admin.json",
  "<<[ package_name ]>> admin API",
];

const mode = process.argv[2];
if (mode === "generate" || mode === "check") {
  await assertPublicBoundary([]);
  await withStagedContracts(mode);
} else if (mode === "public-check") {
  await assertPublicBoundary(process.argv.slice(3));
} else {
  throw new Error(
    "Usage: node scripts/contracts.mjs generate|check|public-check [public-artifact ...]",
  );
}

async function withStagedContracts(mode) {
  const stageRoot = await mkdtemp(join(repoRoot, ".contract-stage-"));
  let preserveStage = false;
  try {
    const staged = [];
    for (const contract of contracts) {
      const document = join(stageRoot, "openapi", `${contract.name}.json`);
      const generated = join(stageRoot, "generated", contract.name);
      await run("cargo", [
        "run",
        "--quiet",
        "-p",
        contract.cargoPackage,
        "--bin",
        "export-openapi",
        "--",
        "--output",
        document,
      ]);
      await createClient({
        input: document,
        output: generated,
        plugins: sharedPlugins,
      });
      if (contract.name === "public") {
        await scanArtifact(document, "staged public OpenAPI document");
        await scanArtifact(generated, "staged public OpenAPI client");
      }
      staged.push({ ...contract, stagedDocument: document, stagedGenerated: generated });
    }

    if (mode === "check") {
      for (const contract of staged) {
        await assertFilesEqual(
          resolve(contract.document),
          contract.stagedDocument,
          `${contract.name} OpenAPI document`,
        );
        await assertTreesEqual(
          resolve(contract.generated),
          contract.stagedGenerated,
          `${contract.name} OpenAPI client`,
        );
      }
      return;
    }

    await publishAtomically(
      staged.flatMap((contract) => [
        { staged: contract.stagedDocument, target: resolve(contract.document) },
        { staged: contract.stagedGenerated, target: resolve(contract.generated) },
      ]),
      stageRoot,
    );
  } catch (error) {
    preserveStage = error?.preserveStage === true;
    if (preserveStage) {
      console.error(`Contract recovery data was preserved at ${stageRoot}`);
    }
    throw error;
  } finally {
    if (!preserveStage) await rm(stageRoot, { force: true, recursive: true });
  }
}

async function publishAtomically(entries, stageRoot) {
  const published = [];
  try {
    for (const [index, entry] of entries.entries()) {
      await mkdir(dirname(entry.target), { recursive: true });
      const backup = join(stageRoot, "backup", String(index));
      const hadOriginal = await pathExists(entry.target);
      if (hadOriginal) {
        await mkdir(dirname(backup), { recursive: true });
        await rename(entry.target, backup);
      }
      try {
        await rename(entry.staged, entry.target);
      } catch (publishError) {
        if (hadOriginal) {
          try {
            await rename(backup, entry.target);
          } catch (restoreError) {
            throw recoveryError(publishError, [restoreError]);
          }
        }
        throw publishError;
      }
      published.push({ ...entry, backup, hadOriginal });
    }
  } catch (publishError) {
    const restoreErrors = [];
    for (const entry of published.reverse()) {
      try {
        await rm(entry.target, { force: true, recursive: true });
        if (entry.hadOriginal) await rename(entry.backup, entry.target);
      } catch (restoreError) {
        restoreErrors.push(restoreError);
      }
    }
    if (restoreErrors.length > 0) throw recoveryError(publishError, restoreErrors);
    throw publishError;
  }
}

function recoveryError(publishError, restoreErrors) {
  const error = new AggregateError(
    [publishError, ...restoreErrors],
    "Contract publication failed and rollback was incomplete",
  );
  error.preserveStage = true;
  return error;
}

async function assertPublicBoundary(explicitArtifacts) {
  const manifests = [
    "apps/<<[ package_name ]>>-api/Cargo.toml",
    "crates/<<[ package_name ]>>-http/Cargo.toml",
[% for dir in public_frontend_dirs %]
    <<[ (dir ~ "/package.json") | tojson ]>>,
[% endfor %]
  ];
  for (const manifest of manifests) {
    await assertContainsNoMarker(resolve(manifest), `public manifest ${manifest}`);
  }
  const { stdout: dependencyTree } = await execFileAsync(
    "cargo",
    ["tree", "--quiet", "-p", "<<[ package_name ]>>-api", "--edges", "normal", "--prefix", "none"],
    { cwd: repoRoot, maxBuffer: 16 * 1024 * 1024 },
  );
  for (const marker of ["<<[ package_name ]>>-admin-http", "<<[ package_name ]>>-admin-api"]) {
    if (dependencyTree.includes(marker)) {
      throw new Error(`Public API dependency tree contains privileged package ${marker}`);
    }
  }

  const conventionalArtifacts = [
    ...publicFrontendDirs.map((directory) => join(directory, "dist")),
    "target/debug/<<[ package_name ]>>-api",
    "target/release/<<[ package_name ]>>-api",
    "docs/public",
    "public-docs",
  ];
  for (const artifact of conventionalArtifacts) {
    const absolute = resolve(artifact);
    if (await pathExists(absolute)) await scanArtifact(absolute, artifact);
  }
  for (const artifact of explicitArtifacts) {
    const absolute = resolve(artifact);
    if (!(await pathExists(absolute))) {
      throw new Error(`Explicit public artifact does not exist: ${artifact}`);
    }
    await scanArtifact(absolute, artifact);
  }
}

async function scanArtifact(path, label) {
  const metadata = await lstat(path);
  if (metadata.isSymbolicLink()) {
    throw new Error(`Refusing to scan symbolic-link public artifact: ${label}`);
  }
  if (metadata.isDirectory()) {
    for (const entry of await readdir(path, { withFileTypes: true })) {
      await scanArtifact(join(path, entry.name), `${label}/${entry.name}`);
    }
    return;
  }
  if (metadata.isFile()) await assertContainsNoMarker(path, label);
}

async function assertContainsNoMarker(path, label) {
  const contents = await readFile(path);
  for (const marker of forbiddenPublicMarkers) {
    if (contents.includes(Buffer.from(marker))) {
      throw new Error(`Public artifact ${label} contains privileged marker ${JSON.stringify(marker)}`);
    }
  }
}

async function assertFilesEqual(committed, generated, label) {
  const [committedContents, generatedContents] = await Promise.all([
    readFile(committed),
    readFile(generated),
  ]);
  if (!committedContents.equals(generatedContents)) {
    throw new Error(`${label} is stale; run the contract:generate package script`);
  }
}

async function assertTreesEqual(committedRoot, generatedRoot, label) {
  const [committedFiles, generatedFiles] = await Promise.all([
    listFiles(committedRoot),
    listFiles(generatedRoot),
  ]);
  const allFiles = [...new Set([...committedFiles, ...generatedFiles])].sort();
  const changed = [];
  for (const file of allFiles) {
    const [committed, generated] = await Promise.all([
      readOptional(join(committedRoot, file)),
      readOptional(join(generatedRoot, file)),
    ]);
    if (!committed || !generated || !committed.equals(generated)) changed.push(file);
  }
  if (changed.length > 0) {
    throw new Error(
      `${label} is stale (${changed.join(", ")}); run the contract:generate package script`,
    );
  }
}

async function listFiles(root) {
  const files = [];
  async function visit(directory) {
    for (const entry of await readdir(directory, { withFileTypes: true })) {
      const path = join(directory, entry.name);
      if (entry.isDirectory()) await visit(path);
      else if (entry.isFile()) files.push(relative(root, path));
      else throw new Error(`Generated contract tree contains a non-file entry: ${path}`);
    }
  }
  await visit(root);
  return files.sort();
}

async function readOptional(path) {
  try {
    return await readFile(path);
  } catch (error) {
    if (error?.code === "ENOENT") return undefined;
    throw error;
  }
}

async function pathExists(path) {
  try {
    await lstat(path);
    return true;
  } catch (error) {
    if (error?.code === "ENOENT") return false;
    throw error;
  }
}

async function run(command, arguments_) {
  await new Promise((resolveRun, rejectRun) => {
    const child = spawn(command, arguments_, { cwd: repoRoot, stdio: "inherit" });
    child.once("error", rejectRun);
    child.once("exit", (code, signal) => {
      if (code === 0) resolveRun();
      else rejectRun(new Error(`${command} exited with ${signal ?? `status ${code}`}`));
    });
  });
}
