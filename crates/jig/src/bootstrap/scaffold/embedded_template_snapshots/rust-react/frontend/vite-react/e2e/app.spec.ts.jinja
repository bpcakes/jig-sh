import { expect, test } from "@playwright/test";

test("renders application status from the live [% if backend_language == "go" %]Go[% else %]Rust[% endif %] API", async ({ page }) => {
  const statusResponsePromise = page.waitForResponse(
    (response) =>
      response.request().method() === "GET" && response.url().endsWith("/api/status"),
  );

  await page.goto("/");

  const statusResponse = await statusResponsePromise;
  expect(statusResponse.ok()).toBe(true);
  expect(statusResponse.headers()["x-request-id"]).toBeTruthy();
  await expect(statusResponse.json()).resolves.toMatchObject({
    version: {
      name: "<<[ repo_name ]>>",
      version: expect.any(String),
    },
    ready: true,
  });
  await expect(page.getByRole("heading", { name: "<<[ title ]>>" })).toBeVisible();
  const applicationCard = page.getByRole("group", { name: "Application", exact: true });
  await expect(applicationCard.locator('[data-slot="card-title"]')).toHaveText(
    "<<[ repo_name ]>>",
  );
  const serviceStatusCard = page.getByRole("group", { name: "[% if backend_language == "go" %]Go[% else %]Rust[% endif %] API", exact: true });
  await expect(serviceStatusCard.getByText("Ready", { exact: true })).toBeVisible();
});
