/// <reference types="vitest/config" />
import path from "node:path"

import tailwindcss from "@tailwindcss/vite"
import { tanstackRouter } from "@tanstack/router-plugin/vite"
import react from "@vitejs/plugin-react"
import { defineConfig } from "vite"

const devPort = Number(process.env.PORT)
const server =
  Number.isInteger(devPort) && devPort > 0
    ? {
        host: "127.0.0.1",
        port: devPort,
        strictPort: true,
        hmr: {
          host: "127.0.0.1",
          clientPort: devPort,
        },
      }
    : {}
const apiOrigin =
  // A current Jig session owns its namespaced topology. API_ORIGIN remains the
  // direct-Vite override when no managed API was selected.
  firstNonEmpty(process.env.JIG_DEV_API_ORIGIN, process.env.API_ORIGIN) ??
  "http://api.<<[ repo_dns_label ]>>.<<[ dev_tld ]>>:<<[ dev_proxy_port ]>>"
const adminApiOrigin =
  firstNonEmpty(
    process.env.JIG_DEV_ADMIN_API_ORIGIN,
    process.env.ADMIN_API_ORIGIN
  ) ?? "http://admin-api.<<[ repo_dns_label ]>>.<<[ dev_tld ]>>:<<[ dev_proxy_port ]>>"

export default defineConfig({
  plugins: [
    tanstackRouter({
      target: "react",
      autoCodeSplitting: true,
      quoteStyle: "double",
      semicolons: false,
    }),
    react(),
    tailwindcss(),
  ],
  resolve: {
    alias: {
      "@": path.resolve(import.meta.dirname, "./src"),
    },
  },
  build: {
    rolldownOptions: {
      output: {
        codeSplitting: {
          groups: [
            {
              name: "vendor",
              test: /node_modules/,
              maxSize: 350_000,
            },
          ],
        },
      },
    },
  },
  server: {
    ...server,
    proxy: {
      "/api": { target: apiOrigin, changeOrigin: true },
      "/health": { target: apiOrigin, changeOrigin: true },
      "/admin-api": { target: adminApiOrigin, changeOrigin: true },
    },
  },
  test: {
    environment: "jsdom",
    globals: true,
    setupFiles: ["./src/test-setup.ts"],
    coverage: {
      include: [
        "src/app/**/*.{ts,tsx}",
        "src/features/**/*.{ts,tsx}",
        "src/lib/**/*.{ts,tsx}",
        "src/routes/**/*.{ts,tsx}",
      ],
      exclude: ["src/routeTree.gen.ts"],
    },
  },
})

function firstNonEmpty(
  ...values: Array<string | undefined>
): string | undefined {
  return values.map((value) => value?.trim()).find((value) => Boolean(value))
}
